package templates

import "github.com/sydlexius/stillwater/internal/i18n"

// RegistryRepairBanner is the admin-only notice that the image registry may
// need repair (#2678, slice 1: read-only). It is mounted once per page in
// layout.templ, inside the IsAdmin gate, right after SharedFilesystemBar.
//
// The markup ships hidden. A small script asks the cached detector endpoint
// (GET /api/v1/reports/registry-repair/banner, itself admin-gated) and reveals
// the banner only when it answers ok=true and needs_repair=true. A failed call
// or ok=false (never checked, or the last check failed) shows nothing and logs
// to the console rather than guessing.
//
// Look: the amber "warn" variant of ConflictBanner (conflictBannerWarn), so the
// two read as one family. Dismissal follows the same session convention as the
// conflict banner's clean bar: a sessionStorage flag, no server state, so a new
// browser session shows the banner again while the registry still needs repair.
//
// LANGUAGE (#2678): <html lang> is hardcoded "en", so the live region and the
// banner each carry lang=<page locale>; otherwise a screen reader would read
// translated text with the English voice (WCAG 3.1.2). The "Last checked" time
// is formatted with that same locale, not the browser's.
//
// RUN (#2678, slice 2): the "Repair now" button confirms through the shared
// showConfirmDialog, POSTs {commit:true} to .../registry-repair/remediate (202
// starts the async job, 409 means one is already running and is followed), then
// polls .../registry-repair/status with the shared pollAsyncStatus. Completion
// is a toast (success, warning for incomplete writes, or a fixed generic failure
// message; the full error stays in the server log), after which the banner
// endpoint is re-read so the banner hides itself when nothing needs repair.
//
// CACHED PLAN (#2678, slice 4): the confirmation dialog opens immediately and
// shows the detector's cached split (rows to rebuild, flags to restore) with how
// long ago it was computed ("As of the last check ({age}) ..."). Nothing is
// fetched or re-scanned on click; the numbers are those of the page's last
// banner read and the completion toast reports the actual result. When the
// endpoint carries no plan (a library repair just finished with failed writes),
// the dialog falls back to the generic confirm text.
templ RegistryRepairBanner() {
	// Always-exposed (visually hidden, never display:none) live region. It starts
	// empty and is filled when the banner appears, so assistive tech announces the
	// change; the visible banner below carries no role of its own, so the message
	// is not announced twice.
	<div id="sw-registry-repair-live" lang={ i18n.TFromCtx(ctx).Locale() } role="status" class="sr-only" aria-label={ t(ctx, "banner.registry_repair.aria_label") }></div>
	<div
		id="sw-registry-repair-banner"
		lang={ i18n.TFromCtx(ctx).Locale() }
		role="region"
		aria-labelledby="sw-registry-repair-title"
		class="hidden bg-gradient-to-r from-amber-900/60 to-yellow-700/50 dark:from-amber-900/60 dark:to-yellow-700/50 backdrop-blur-md border-b border-amber-300/30 px-6 py-3"
		data-count-one={ t(ctx, "banner.registry_repair.body.one") }
		data-count-other={ t(ctx, "banner.registry_repair.body.other") }
		data-checked-template={ t(ctx, "banner.registry_repair.checked") }
		data-confirm={ t(ctx, "banner.registry_repair.confirm") }
		data-confirm-plan={ t(ctx, "banner.registry_repair.confirm_plan") }
		data-running-label={ t(ctx, "banner.registry_repair.running") }
		data-toast-started={ t(ctx, "banner.registry_repair.toast.started") }
		data-toast-already-running={ t(ctx, "banner.registry_repair.toast.already_running") }
		data-toast-done={ t(ctx, "banner.registry_repair.toast.done") }
		data-toast-incomplete-one={ t(ctx, "banner.registry_repair.toast.incomplete.one") }
		data-toast-incomplete-other={ t(ctx, "banner.registry_repair.toast.incomplete.other") }
		data-toast-failed={ t(ctx, "banner.registry_repair.toast.failed") }
	>
		<div class="max-w-6xl mx-auto flex flex-wrap items-center gap-4">
			<div class="flex items-center gap-3 min-w-0 flex-1">
				<span class="inline-block h-2 w-2 rounded-full bg-amber-400 ring-4 ring-amber-400/20 shrink-0" aria-hidden="true"></span>
				<div class="min-w-0">
					<div id="sw-registry-repair-title" class="font-semibold text-amber-100">
						{ t(ctx, "banner.registry_repair.title") }
						<span id="sw-registry-repair-count" class="font-normal text-amber-100"></span>
					</div>
					<div id="sw-registry-repair-checked" class="text-xs text-amber-100 mt-0.5"></div>
					<a
						href="https://sydlexius.github.io/stillwater/how-to/repair-image-registry/#background-check"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block text-xs text-amber-100 underline underline-offset-2 hover:text-white mt-0.5"
					>{ t(ctx, "common.learn_more") }</a>
				</div>
			</div>
			<div id="sw-registry-repair-actions" class="flex items-center gap-3 shrink-0">
				<button
					id="sw-registry-repair-run"
					type="button"
					class="px-2.5 py-1 min-h-[24px] rounded-md bg-amber-400/90 text-amber-950 text-xs font-medium hover:bg-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-100 disabled:opacity-70 disabled:cursor-not-allowed"
				>{ t(ctx, "banner.registry_repair.run") }</button>
				<button
					id="sw-registry-repair-dismiss"
					type="button"
					class="inline-flex h-[24px] w-[24px] shrink-0 items-center justify-center -m-1 text-amber-100/80 hover:text-white"
					aria-label={ t(ctx, "banner.registry_repair.dismiss_aria") }
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		</div>
		<script>
			(function () {
				var DISMISS_KEY = 'sw_registry_repair_dismissed';
				var el = document.getElementById('sw-registry-repair-banner');
				if (!el) return;
				try {
					if (sessionStorage.getItem(DISMISS_KEY) === '1') { el.remove(); return; }
				} catch (e) { /* storage blocked: fall through and show per session */ }

				document.getElementById('sw-registry-repair-dismiss').addEventListener('click', function () {
					try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch (e) { console.error('registry repair banner: cannot persist dismissal', e); }
					// Move focus to the skip-link target BEFORE removing the focused
					// button, or focus drops to <body> and a keyboard user loses place.
					var main = document.getElementById('sw-main');
					if (main) main.focus();
					clearTimeout(retryTimer);
					el.remove();
				});

				var meta = document.querySelector('meta[name="htmx-base-path"]');
				var base = meta ? meta.content : '';
				var runBtn = document.getElementById('sw-registry-repair-run');
				var runLabel = runBtn.textContent;
				// Unusable answers (detector has not finished its first check, or the
				// call failed) are retried a bounded number of times while the page
				// stays open: 5s, 15s, 45s after the previous attempt, then give up.
				var RETRY_DELAYS_MS = [5000, 15000, 45000];
				var retryTimer = null;
				var attempt = 0;
				function retryLater() {
					if (attempt >= RETRY_DELAYS_MS.length) return;
					retryTimer = setTimeout(check, RETRY_DELAYS_MS[attempt++]);
				}
				// Prefer the browser's regional variant of the page language (en-GB
				// over en) so en keeps its regional date format; else the page language.
				function dateLocale() {
					// Same fallback order as the language picker: navigator.languages,
					// else navigator.language, so a region survives when the list is empty.
					var langs = (Array.isArray(navigator.languages) && navigator.languages.length > 0)
						? navigator.languages
						: (navigator.language ? [navigator.language] : []);
					for (var i = 0; i < langs.length; i++) {
						if (langs[i].split('-')[0].toLowerCase() === el.lang) return langs[i];
					}
					return el.lang || undefined;
				}
				// Cached detector answer from the last banner read, shown in the confirm
				// dialog. lastPlan is null when the endpoint sent no split.
				var lastPlan = null;
				var lastChecked = null;
				// ageText renders how long ago `when` was, in the page locale (the same
				// dateLocale() as the checked-at line): minutes under an hour, hours
				// under 48, else days. Clock skew (a future time) clamps to zero. A failing
				// Intl.RelativeTimeFormat is logged and the absolute time shown instead.
				function ageText(when) {
					var mins = Math.max(0, Math.floor((Date.now() - when.getTime()) / 60000));
					var n = mins, unit = 'minute';
					if (mins >= 48 * 60) { n = Math.floor(mins / 1440); unit = 'day'; }
					else if (mins >= 60) { n = Math.floor(mins / 60); unit = 'hour'; }
					try {
						return new Intl.RelativeTimeFormat(dateLocale(), { numeric: 'auto' }).format(-n, unit);
					} catch (e) {
						console.error('registry repair banner: Intl.RelativeTimeFormat failed; showing the absolute time', e);
						return when.toLocaleString(dateLocale());
					}
				}
				// confirmMessage is the dialog text: the cached plan when known (age computed
				// now, so a page left open shows the true age), else the generic text.
				function confirmMessage() {
					if (!lastPlan) return el.dataset.confirm;
					return el.dataset.confirmPlan
						.replace('{age}', ageText(lastChecked))
						.replace('{rebuilt}', String(lastPlan.rebuild))
						.replace('{restored}', String(lastPlan.restore));
				}
				function check() {
					if (!el.isConnected) return;
					fetch(base + '/api/v1/reports/registry-repair/banner', {
						credentials: 'same-origin',
						headers: { Accept: 'application/json' }
					}).then(function (resp) {
						if (!resp.ok) throw new Error('banner endpoint answered HTTP ' + resp.status);
						return resp.json();
					}).then(function (d) {
						// Dismissed while the request was in flight: nothing to fill.
						if (!el.isConnected) return;
						if (!d || d.ok !== true) {
							// Expected for ~2 minutes after boot (never checked), so not an error.
							console.info('registry repair banner: detector has no usable result (never checked, or the last check failed)');
							retryLater();
							return;
						}
						if (d.needs_repair !== true || !(d.count > 0)) {
							// Clean (e.g. right after a repair): hide and clear the live region.
							// The shared confirm modal returns focus to the run button, and the
							// disabled running button then drops it to <body>; hiding the banner
							// would strand focus in a hidden subtree or lose it. Move it to the
							// skip-link target when it is inside the banner or already lost.
							var ae = document.activeElement;
							if (!ae || ae === document.body || el.contains(ae)) {
								var main = document.getElementById('sw-main');
								if (main) main.focus(); else console.error('registry repair banner: #sw-main missing; focus left in hidden banner');
							}
							el.classList.add('hidden');
							document.getElementById('sw-registry-repair-live').textContent = '';
							return;
						}
						var tpl = d.count === 1 ? el.dataset.countOne : el.dataset.countOther;
						document.getElementById('sw-registry-repair-count').textContent = '-- ' + tpl.replace('{count}', String(d.count));
						var when = new Date(d.checked_at);
						lastPlan = null;
						if (d.plan && !(Number.isFinite(d.plan.rebuild) && Number.isFinite(d.plan.restore))) {
							console.error('registry repair banner: plan is not a pair of finite numbers; using the generic confirmation');
						} else if (d.plan && !isNaN(when.getTime())) {
							lastPlan = { rebuild: d.plan.rebuild, restore: d.plan.restore };
							lastChecked = when;
						} else if (d.plan) {
							console.error('registry repair banner: plan present without a valid checked_at; using the generic confirmation');
						}
						if (!isNaN(when.getTime())) {
							document.getElementById('sw-registry-repair-checked').textContent =
								el.dataset.checkedTemplate.replace('{time}', when.toLocaleString(dateLocale()));
						}
						el.classList.remove('hidden');
						// Announce via the separate always-exposed live region.
						document.getElementById('sw-registry-repair-live').textContent =
							el.querySelector('.font-semibold').textContent.replace(/\s+/g, ' ').trim() + ' ' +
							document.getElementById('sw-registry-repair-checked').textContent;
					}).catch(function (err) {
						console.error('registry repair banner: check failed', err);
						retryLater();
					});
				}
				check();

				// ---- Run flow (#2678 slice 2) ----
				var stickyToast = null;
				function toast(kind, msg) {
					var fn = window[kind];
					if (typeof fn !== 'function') { console.error('registry repair banner: window.' + kind + ' is unavailable; message not shown:', msg); return null; }
					return fn(msg, el.lang);
				}
				function csrf() {
					if (typeof window.swCsrfToken !== 'function') { console.error('registry repair banner: swCsrfToken unavailable; the POST will 403'); return ''; }
					return window.swCsrfToken();
				}
				function setRunning(on) {
					runBtn.disabled = on;
					runBtn.setAttribute('aria-busy', on ? 'true' : 'false');
					runBtn.textContent = on ? el.dataset.runningLabel : runLabel;
				}
				function finish(kind, msg) {
					setRunning(false);
					stickyToast = toast(kind, msg);
					attempt = 0;
					check(); // re-read the cached state so a clean registry hides the banner
				}
				function follow() {
					if (typeof pollAsyncStatus !== 'function') {
						console.error('registry repair banner: pollAsyncStatus unavailable');
						finish('showToast', el.dataset.toastFailed);
						return;
					}
					pollAsyncStatus(base + '/api/v1/reports/registry-repair/status', {
						onData: function (s) {
							if (s.status === 'running') return false;
							if (s.status === 'completed' && s.report) {
								var r = s.report;
								if (r.write_failures > 0) {
									finish('showWarningToast', (r.write_failures === 1 ? el.dataset.toastIncompleteOne : el.dataset.toastIncompleteOther).replace('{failures}', String(r.write_failures)));
								} else {
									finish('showStickyToast', el.dataset.toastDone.replace('{rebuilt}', String(r.rebuilt)).replace('{restored}', String(r.restored)));
								}
							} else {
								// failed, or idle (cut off by a restart): fixed message, detail is in the server log.
								console.error('registry repair banner: run ended with status', s.status, s.error_code || '');
								finish('showToast', el.dataset.toastFailed);
							}
							return true;
						},
						onHTTPError: function (code) { console.error('registry repair banner: status HTTP ' + code); finish('showToast', el.dataset.toastFailed); },
						onNetworkError: function (err) { console.error('registry repair banner: status poll failed', err); finish('showToast', el.dataset.toastFailed); }
					});
				}
				// A 409 has three causes: a COMMITTED repair is running (follow it), a
				// PREVIEW is running (not ours: report nothing as done), or the background
				// detector scan holds the claim (nothing is running: retry the POST a few
				// times, then fail). The status endpoint tells them apart.
				var CONFLICT_RETRIES = 5, CONFLICT_RETRY_MS = 1000;
				function onConflict(triesLeft) {
					fetch(base + '/api/v1/reports/registry-repair/status', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
						.then(function (r) { if (!r.ok) throw new Error('status HTTP ' + r.status); return r.json(); })
						.then(function (s) {
							if (s && s.status === 'running' && s.commit === true) {
								toast('showToast', el.dataset.toastAlreadyRunning); follow(); return;
							}
							if (s && s.status === 'running') {
								console.info('registry repair banner: a preview run holds the repair slot; not following it');
								setRunning(false);
								toast('showToast', el.dataset.toastAlreadyRunning);
								return;
							}
							if (triesLeft > 0) { setTimeout(function () { post(triesLeft - 1); }, CONFLICT_RETRY_MS); return; }
							console.error('registry repair banner: still refused (409) with no run in progress; the background check may be busy');
							finish('showToast', el.dataset.toastFailed);
						}).catch(function (err) {
							console.error('registry repair banner: cannot classify the 409', err);
							finish('showToast', el.dataset.toastFailed);
						});
				}
				function start() {
					setRunning(true);
					if (stickyToast && typeof stickyToast.dismiss === 'function') { stickyToast.dismiss(); }
					stickyToast = null;
					post(CONFLICT_RETRIES);
				}
				function post(triesLeft) {
					fetch(base + '/api/v1/reports/registry-repair/remediate', {
						method: 'POST',
						credentials: 'same-origin',
						headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
						body: JSON.stringify({ commit: true })
					}).then(function (resp) {
						if (resp.status === 202) { toast('showSuccessToast', el.dataset.toastStarted); follow(); return; }
						if (resp.status === 409) { onConflict(triesLeft); return; }
						console.error('registry repair banner: start refused, HTTP ' + resp.status);
						finish('showToast', el.dataset.toastFailed);
					}).catch(function (err) {
						console.error('registry repair banner: start failed', err);
						finish('showToast', el.dataset.toastFailed);
					});
				}
				runBtn.addEventListener('click', function () {
					if (typeof window.showConfirmDialog !== 'function') {
						console.error('registry repair banner: showConfirmDialog unavailable');
						return;
					}
					window.showConfirmDialog(confirmMessage(), null, start, {
						lang: el.lang,
						acceptClass: 'px-4 py-2 rounded-md bg-amber-500 text-amber-950 text-sm font-medium hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-300'
					});
				});
			})();
		</script>
	</div>
}
