package templates

import (
	"context"
	"strconv"
)

// ExtraFanartMaxRows is how many table rows the preview renders. A library-wide
// preview can list thousands of files (about 1 MB of HTML at 3,250), so the page
// shows the first rows and says how many it left out; the summary tiles still
// count every file.
const ExtraFanartMaxRows = 500

// commaInt formats n with thousands separators (3250 -> "3,250").
func commaInt(n int) string {
	s := strconv.Itoa(n)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "," + s[i:]
	}
	return s
}

// visibleRows returns the rows to render: all of them up to the cap.
func (v ExtraFanartMigrationView) visibleRows() []ExtraFanartMigrationRow {
	if limit := v.rowCap(); len(v.Rows) > limit {
		return v.Rows[:limit]
	}
	return v.Rows
}

// rowCap is RowCap when a caller set one (tests), else ExtraFanartMaxRows.
func (v ExtraFanartMigrationView) rowCap() int {
	if v.RowCap > 0 {
		return v.RowCap
	}
	return ExtraFanartMaxRows
}

// cappedNote is the line shown when rows were left out, or "" when none were.
func (v ExtraFanartMigrationView) cappedNote(ctx context.Context) string {
	if len(v.Rows) <= v.rowCap() {
		return ""
	}
	return tf(ctx, "extrafanart_migration.rows_capped", commaInt(v.rowCap()), commaInt(len(v.Rows)))
}

// ExtraFanartMigrationRow is one extrafanart/ file (or one artist-level error,
// File empty) in the migration preview or receipt.
type ExtraFanartMigrationRow struct {
	ArtistID string
	Artist   string
	File     string
	Dest     string
	Outcome  string // planned, skipped, blocked, failed; moved, source_gone after a run
	Reason   string
}

// ExtraFanartMigrationView is the view model for /reports/extrafanart-migration
// (#3179). Loading the page shows a PREVIEW: it reads what would move and
// changes nothing. The same body, with Receipt set, is the answer to a run.
type ExtraFanartMigrationView struct {
	BasePath         string
	Running          bool   // another run holds the singleton slot
	Aborted          bool   // the preview or run stopped before finishing; rows are incomplete
	SkippedMissing   int    // artists skipped because their folder was not found
	Status           string // planned, blocked, nothing_to_do, nothing_checked, failed; migrated, partial after a run
	ArtistsWithFiles int
	Moves            int // files the migration would move
	SkippedIdentical int
	Problems         int
	Rows             []ExtraFanartMigrationRow
	RowCap           int  // 0 means ExtraFanartMaxRows; only tests set it
	Receipt          bool // the result of a live run, not a preview
	Fragment         bool // swapped into an open page: its first heading takes focus
	Moved            int  // files a run moved
	Failed           int  // files a run was due to move and did not
}

// ExtraFanartMigrationPage renders the admin-gated extrafanart/ migration
// preview, laid out like the platform backdrop duplicates report it is modelled
// on (same card, heading and table markup).
templ ExtraFanartMigrationPage(assets AssetPaths, view ExtraFanartMigrationView) {
	@Layout(t(ctx, "extrafanart_migration.page_title"), assets) {
		<div class="sw-extrafanart-migration space-y-6">
			<div class="sw-card rounded-lg px-3 py-2">
				<div class="min-w-0">
					<h1 class="text-xs font-semibold leading-tight">{ t(ctx, "extrafanart_migration.title") }</h1>
					<p class="mt-0.5 text-xs text-gray-600 dark:text-gray-400 leading-snug">
						{ t(ctx, "extrafanart_migration.subtitle") }
					</p>
				</div>
			</div>
			@ExtraFanartMigrationBody(view)
		</div>
	}
}

// ExtraFanartMigrationBody is the content below the page header: the preview on
// a page load, or the receipt of a run (the answer the POST endpoint gives an
// htmx request, as the page body alone).
templ ExtraFanartMigrationBody(view ExtraFanartMigrationView) {
	<div id="extrafanart-migration-body" class="space-y-6">
		if view.Running {
			<div id="extrafanart-migration-running" class="sw-card rounded-lg px-3 py-2 border-l-4 sw-card-accent-amber" role="alert">
				<p
					class="text-xs font-semibold leading-tight text-amber-800 dark:text-amber-400"
					if view.Fragment {
						tabindex="-1"
						autofocus
					}
				>{ t(ctx, "extrafanart_migration.running_title") }</p>
				<p class="mt-0.5 text-xs text-gray-600 dark:text-gray-400 leading-snug">{ t(ctx, "extrafanart_migration.running_body") }</p>
			</div>
		} else if view.Aborted && len(view.Rows) == 0 {
			// Stopped before reaching anything: there are no counts or rows to show,
			// and the table's empty state ("nothing to migrate") would be false.
			if view.Receipt {
				@extraFanartReceipt(view)
			} else {
				@extraFanartErrorCard()
			}
		} else {
			if view.Receipt {
				@extraFanartReceipt(view)
			} else if view.Aborted {
				// Whatever rows follow are only what the preview reached before it
				// stopped, so they are NOT a complete plan: the card says so.
				@extraFanartErrorCard()
			}
			if view.SkippedMissing > 0 {
				<div id="extrafanart-migration-skipped" class="sw-card rounded-lg px-3 py-2 border-l-4 sw-card-accent-amber" role="alert">
					<p class="text-xs text-gray-600 dark:text-gray-300 leading-snug">
						{ tn(ctx, "extrafanart_migration.skipped_missing", view.SkippedMissing) }
					</p>
				</div>
			}
			<div class="sw-card rounded-lg px-3 py-2">
				<dl class="grid grid-cols-1 sm:grid-cols-4 gap-3">
					<div>
						<dt class="text-xs text-gray-600 dark:text-gray-400">{ t(ctx, "extrafanart_migration.status_label") }</dt>
						<dd class="text-lg font-semibold" id="extrafanart-migration-status">{ extraFanartLabel(ctx, "status", view.Status) }</dd>
					</div>
					if view.Receipt {
						// A receipt counts what happened, not what was planned.
						<div>
							<dt class="text-xs text-gray-600 dark:text-gray-400">{ t(ctx, "extrafanart_migration.files_moved") }</dt>
							<dd class="text-lg font-semibold" id="extrafanart-migration-moved">{ strconv.Itoa(view.Moved) }</dd>
						</div>
						<div>
							<dt class="text-xs text-gray-600 dark:text-gray-400">{ t(ctx, "extrafanart_migration.files_not_moved") }</dt>
							<dd class="text-lg font-semibold" id="extrafanart-migration-failed">{ strconv.Itoa(view.Failed) }</dd>
						</div>
					} else {
						<div>
							<dt class="text-xs text-gray-600 dark:text-gray-400">{ t(ctx, "extrafanart_migration.artists_with_files") }</dt>
							<dd class="text-lg font-semibold" id="extrafanart-migration-artists">{ strconv.Itoa(view.ArtistsWithFiles) }</dd>
						</div>
						<div>
							<dt class="text-xs text-gray-600 dark:text-gray-400">{ t(ctx, "extrafanart_migration.files_to_move") }</dt>
							<dd class="text-lg font-semibold" id="extrafanart-migration-moves">{ strconv.Itoa(view.Moves) }</dd>
						</div>
					}
					<div>
						<dt class="text-xs text-gray-600 dark:text-gray-400">{ t(ctx, "extrafanart_migration.files_identical") }</dt>
						<dd class="text-lg font-semibold" id="extrafanart-migration-identical">{ strconv.Itoa(view.SkippedIdentical) }</dd>
					</div>
				</dl>
			</div>
			// The problems count shows on a receipt too: a run that only hit planning
			// or listing errors has Failed == 0, and would otherwise under-report.
			if view.Problems > 0 {
				<div id="extrafanart-migration-problems" class="sw-card rounded-lg px-3 py-2 border-l-4 sw-card-accent-amber" role="alert">
					<p class="text-xs font-semibold leading-tight text-amber-800 dark:text-amber-400">{ t(ctx, "extrafanart_migration.problems_title") }</p>
					<p class="mt-0.5 text-xs text-gray-600 dark:text-gray-400 leading-snug">
						{ tn(ctx, "extrafanart_migration.problems_body", view.Problems) }
					</p>
				</div>
			}
			if !view.Receipt {
				<div class="sw-card rounded-lg px-3 py-2">
					<p id="extrafanart-migration-warning" class="text-xs text-gray-600 dark:text-gray-400 leading-snug max-w-prose">
						{ t(ctx, "extrafanart_migration.warning") }
					</p>
				</div>
			}
			if note := view.cappedNote(ctx); note != "" {
				<p id="extrafanart-migration-capped" class="text-xs text-gray-600 dark:text-gray-400 leading-snug">{ note }</p>
			}
			<div id="extrafanart-migration-table" class="sw-card rounded-lg overflow-x-auto">
				if len(view.Rows) == 0 {
					<p id="extrafanart-migration-empty" class="px-3 py-4 text-xs text-gray-600 dark:text-gray-400">
						{ t(ctx, "extrafanart_migration.empty") }
					</p>
				} else {
					<table class="min-w-full text-xs">
						<thead>
							<tr class="text-left text-gray-600 dark:text-gray-400">
								<th class="px-3 py-2 font-medium">{ t(ctx, "extrafanart_migration.column_artist") }</th>
								<th class="px-3 py-2 font-medium">{ t(ctx, "extrafanart_migration.column_file") }</th>
								<th class="px-3 py-2 font-medium">{ t(ctx, "extrafanart_migration.column_destination") }</th>
								<th class="px-3 py-2 font-medium">{ t(ctx, "extrafanart_migration.column_outcome") }</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range view.visibleRows() {
								<tr class="border-t border-gray-100 dark:border-gray-800">
									<td class="px-3 py-2">
										<a class="underline" href={ templ.SafeURL(view.BasePath + "/artists/" + row.ArtistID) }>{ row.Artist }</a>
									</td>
									<td class="px-3 py-2">{ row.File }</td>
									<td class="px-3 py-2">{ row.Dest }</td>
									<td class="px-3 py-2">
										{ extraFanartLabel(ctx, "outcome", row.Outcome) }
										if row.Reason != "" {
											<span class="text-gray-600 dark:text-gray-400">{ " - " + extraFanartLabel(ctx, "reason", row.Reason) }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		}
	</div>
}

// extraFanartErrorCard is the notice shown when the preview stopped before finishing.
templ extraFanartErrorCard() {
	<div id="extrafanart-migration-error" class="sw-card rounded-lg px-3 py-2 border-l-4 sw-card-accent-amber" role="alert">
		<p class="text-xs font-semibold leading-tight text-amber-800 dark:text-amber-400">{ t(ctx, "extrafanart_migration.error_title") }</p>
		<p class="mt-0.5 text-xs text-gray-600 dark:text-gray-400 leading-snug">{ t(ctx, "extrafanart_migration.error_body") }</p>
	</div>
}

// extraFanartReceipt is the card that says how a run went. Neutral for a clean
// outcome, the amber accent for anything that needs the operator; its heading
// takes focus when the body is rendered as a fragment (Fragment set).
templ extraFanartReceipt(view ExtraFanartMigrationView) {
	<div
		id="extrafanart-migration-receipt"
		if view.receiptNeedsAttention() {
			class="sw-card rounded-lg px-3 py-2 border-l-4 sw-card-accent-amber"
			role="alert"
		} else {
			class="sw-card rounded-lg px-3 py-2"
			role="status"
		}
	>
		<h2
			id="extrafanart-migration-receipt-title"
			if view.receiptNeedsAttention() {
				class="text-xs font-semibold leading-tight text-amber-800 dark:text-amber-400"
			} else {
				class="text-xs font-semibold leading-tight"
			}
			if view.Fragment {
				tabindex="-1"
				autofocus
			}
		>{ view.receiptTitle(ctx) }</h2>
		<p id="extrafanart-migration-receipt-body" class="mt-0.5 text-xs text-gray-600 dark:text-gray-400 leading-snug max-w-prose">
			{ view.receiptBody(ctx) }
			<a class="underline" href={ templ.SafeURL(view.BasePath + "/reports/extrafanart-migration") }>{ t(ctx, "extrafanart_migration.receipt_preview_again") }</a>
		</p>
	</div>
}
