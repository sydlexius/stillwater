package templates

import (
	"context"
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/sydlexius/stillwater/internal/artist"
	img "github.com/sydlexius/stillwater/internal/image"
	"github.com/sydlexius/stillwater/web/components"
)

// ReportsPageData is the view model for the reports two-pane workspace
// (M55 #1337; promoted to the canonical /reports in #1757 PR-4). ActiveReport
// identifies which built-in report is selected (e.g.
// "compliance"). The matching data field is populated for each live report
// ("compliance", "health", "metadata-completeness", "rule-pass-rates");
// unrecognized or deferred report names render a placeholder pane.
type ReportsPageData struct {
	ActiveReport   string
	ComplianceData ComplianceData
	// HealthData is populated when ActiveReport=="health".
	HealthData HealthSummaryData
	// MetadataReport is populated when ActiveReport=="metadata-completeness".
	MetadataReport *artist.MetadataCompletenessReport
	// RulePassRates is populated when ActiveReport=="rule-pass-rates".
	RulePassRates []RulePassRateData
	// BlastRadiusData is populated when ActiveReport=="blast-radius".
	BlastRadiusData BlastRadiusData
	// NFOMBIDData is populated when ActiveReport=="nfo-has-mbid" (issue #2809).
	NFOMBIDData NFOMBIDPaneData
}

// repBuiltinReport is a single entry in the reports rail.
type repBuiltinReport struct {
	ID       string
	LabelKey string
	DescKey  string
}

// repBuiltinReports is the ordered list of built-in reports shown in the rail.
// IDs match the {name} path segment in /reports/{name}. The first six
// entries have live right-panes; the remaining six render a placeholder.
// blast-radius is placed second, ahead of the metadata/rule-pass-rate
// reports, because it is a data-loss report and should not sit below
// lower-stakes ones (#2750).
//
// nfo-has-mbid sits directly after blast-radius (#2809, the pane half of the
// issue the maintainer reopened because an API + CSV alone did not meet the
// "surfaced somewhere an operator can act on it" bar). It belongs beside
// blast-radius rather than further down the rail: both report on writes that
// an automated fixer made without operator confirmation, and this registry
// already sorts that kind of report above the lower-stakes ones (compliance
// snapshots, coverage summaries) that follow.
var repBuiltinReports = []repBuiltinReport{
	{"compliance", "reports.compliance.label", "reports.compliance.desc"},
	{"blast-radius", "reports.blast_radius.label", "reports.blast_radius.desc"},
	{"nfo-has-mbid", "reports.nfo_has_mbid.label", "reports.nfo_has_mbid.desc"},
	{"health", "reports.health_report.label", "reports.health_report.desc"},
	{"metadata-completeness", "reports.metadata_completeness.label", "reports.metadata_completeness.desc"},
	{"rule-pass-rates", "reports.rule_pass_rates.label", "reports.rule_pass_rates.desc"},
	{"underrated-artists", "reports.underrated.label", "reports.underrated.desc"},
	{"image-coverage", "reports.image_coverage.label", "reports.image_coverage.desc"},
	{"connection-sync", "reports.connection.label", "reports.connection.desc"},
	{"id-metadata-coverage", "reports.id_metadata.label", "reports.id_metadata.desc"},
	{"state-records", "reports.state_records.label", "reports.state_records.desc"},
	{"weekly-review-queue", "reports.weekly_review.label", "reports.weekly_review.desc"},
}

// repFilterCount returns the number of active filters on the compliance data,
// used to badge the Filters trigger button. It intentionally differs from
// complianceActiveFilterCount (compliance.templ): the workspace toolbar keeps
// the search box separate from the flyout, so Search counts here, and the two
// health bounds collapse into one "health range" filter for the badge.
func repFilterCount(data ComplianceData) int {
	n := 0
	if data.Search != "" {
		n++
	}
	if data.Status != "" && data.Status != "all" {
		n++
	}
	if data.Filter != "" {
		n++
	}
	if data.LibraryID != "" {
		n++
	}
	if data.HealthScoreMin > 0 || data.HealthScoreMax > 0 {
		n++
	}
	return n
}

// ReportsPage renders the reports two-pane workspace (M55 #1337; promoted to
// the canonical /reports in #1757 PR-4).
// The left rail (260 px) lists built-in reports; clicking one navigates to
// /reports/{name}. The right pane renders the active report content.
// Logged-out visitors reach this page via wrapOptionalAuth; the handler calls
// requireAuth internally and redirects to login if the session is absent.
templ ReportsPage(assets AssetPaths, data ReportsPageData) {
	@Layout(t(ctx, "reports.page_title"), assets) {
		<script src={ assets.ChartJS }></script>
		<div class="sw-next-reports">
			<h1 class="sr-only">{ t(ctx, "reports.page_title") }</h1>
			<div class="sw-rep-workspace sw-card">
				<!-- Left rail: 260px on desktop; a slide-over drawer at <=768px -->
				<nav class="sw-rep-rail" id="sw-rep-rail" aria-label={ t(ctx, "reports.page_title") }>
					<div class="sw-rep-rail-search">
						<svg class="sw-rep-rail-search-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd"></path>
						</svg>
						<input
							type="search"
							id="rep-rail-filter"
							data-sw-shortcut="s"
							data-sw-shortcut-label={ t(ctx, "reports.shortcuts.search_reports") }
							placeholder={ t(ctx, "reports.rail_filter_placeholder") }
							class="sw-rep-rail-filter-input"
							oninput="swRepRailFilter(this.value)"
							autocomplete="off"
						/>
					</div>
					<div class="sw-rep-list-wrap">
						<p class="sw-rep-list-label" aria-hidden="true">{ t(ctx, "reports.section_builtin") }</p>
						<ul role="list" class="sw-rep-list" id="sw-rep-list">
							for _, r := range repBuiltinReports {
								<li class="sw-rep-list-item" data-rep-label={ t(ctx, r.LabelKey) }>
									<a
										href={ templ.SafeURL(assets.BasePath + "/reports/" + r.ID) }
										class={ "sw-rep-item", templ.KV("is-active", data.ActiveReport == r.ID) }
										if data.ActiveReport == r.ID {
											aria-current="page"
										}
									>
										<div class="sw-rep-item-body">
											<span class="sw-rep-item-label">{ t(ctx, r.LabelKey) }</span>
											<span class="sw-rep-item-desc">{ t(ctx, r.DescKey) }</span>
										</div>
									</a>
								</li>
							}
						</ul>
					</div>
				</nav>
				<!-- Right pane -->
				<div class="sw-rep-pane" id="sw-rep-pane">
					<!-- Mobile-only (<=768px) drawer toggle; ghost/outline icon button. -->
					<button
						type="button"
						class="sw-rep-rail-toggle"
						aria-label={ t(ctx, "reports.open_rail") }
						aria-controls="sw-rep-rail"
						aria-expanded="false"
						onclick="swReportsRailDrawer.toggle()"
					>
						<svg class="sw-rep-rail-toggle-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5A.75.75 0 0 1 2.75 9h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 9.75Zm0 5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd"></path>
						</svg>
						<span>{ t(ctx, "reports.page_title") }</span>
					</button>
					if data.ActiveReport == "compliance" {
						@repPaneCompliance(assets, data.ComplianceData)
					} else if data.ActiveReport == "blast-radius" {
						@repPaneBlastRadius(data.BlastRadiusData)
					} else if data.ActiveReport == "nfo-has-mbid" {
						@repPaneNFOHasMBID(data.NFOMBIDData)
					} else if data.ActiveReport == "health" {
						@repPaneHealth(data.HealthData)
					} else if data.ActiveReport == "metadata-completeness" {
						@repPaneMetadataCompleteness(data.MetadataReport)
					} else if data.ActiveReport == "rule-pass-rates" {
						@repPaneRulePassRates(data.RulePassRates)
					} else {
						@repPanePlaceholder(ctx, data.ActiveReport)
					}
				</div>
				<!-- Scrim for the mobile rail drawer (tap to close). Sits inside the
				     workspace card so it overlays the reports surface; the drawer
				     (z 50) stacks above it (z 49). Hidden entirely on desktop. -->
				<div class="sw-rep-rail-scrim" id="sw-rep-rail-scrim" onclick="swReportsRailDrawer.close()" aria-hidden="true"></div>
			</div>
			<!-- Keyboard tip line (mirrors the artists list footer): "s" focuses
			     the rail search on every report; "/" focuses the compliance
			     pane's search-artists box and "f" opens its filter flyout, so
			     those two are listed only when that pane (and their targets)
			     is rendered. Keycap hints are owned by the #1789 registry via
			     the data-sw-shortcut attributes above. -->
			<p class="sw-list-tips" role="note">
				<span class="font-medium">{ t(ctx, "reports.shortcuts.tip_label") }:</span>
				if data.ActiveReport == "compliance" {
					<span class="inline-flex items-center"><kbd class="sw-kbd inline-flex">/</kbd><span class="ml-1">{ t(ctx, "reports.shortcuts.search") }</span></span>
					<span aria-hidden="true">·</span>
				}
				<span class="inline-flex items-center"><kbd class="sw-kbd inline-flex">s</kbd><span class="ml-1">{ t(ctx, "reports.shortcuts.search_reports") }</span></span>
				if data.ActiveReport == "compliance" {
					<span aria-hidden="true">·</span>
					<span class="inline-flex items-center"><kbd class="sw-kbd inline-flex">f</kbd><span class="ml-1">{ t(ctx, "reports.shortcuts.tip_filters") }</span></span>
				}
			</p>
		</div>
		@repRailFilterScript()
		@repRailDrawerScript()
	}
}

// repPaneCompliance renders the right pane for the Compliance overview report.
// It reuses ComplianceResults (including ComplianceTable, pagination,
// and active filter chips) and ComplianceFilterFlyout without
// forking them. The toolbar, summary band, and bulk action bar are inline since
// they require the workspace scope.
templ repPaneCompliance(assets AssetPaths, data ComplianceData) {
	<!-- Pane header -->
	<div class="sw-rep-pane-header">
		<div class="sw-rep-pane-title-block">
			<p class="sw-rep-pane-title">{ t(ctx, "reports.compliance.label") }</p>
			<p class="sw-rep-pane-desc">{ t(ctx, "reports.compliance.desc") }</p>
		</div>
		<div class="sw-rep-pane-actions">
			<!-- Run Rules / Re-evaluate All (#698 port-parity, restored in #1757
			     PR-4 UAT): the primary button starts an incremental run through
			     the confirmAndRunRules estimate/confirm flow; the secondary
			     forces a full re-evaluation. Both target the existing
			     /api/v1/rules/run-all endpoints. Styled on the sw-rep glass
			     motif; the primary fills with the user's accent token rather
			     than a hardcoded blue. -->
			<button
				id="run-rules-btn"
				type="button"
				onclick="confirmAndRunRules('incremental')"
				title={ t(ctx, "report.run_rules_tooltip") }
				aria-controls="confirm-modal"
				aria-haspopup="dialog"
				data-label-run={ t(ctx, "report.run_rules") }
				data-label-running={ t(ctx, "report.running") }
				data-toast-started={ t(ctx, "report.rule_evaluation_started") }
				data-toast-already-running={ t(ctx, "report.already_running") }
				data-toast-failed-start={ t(ctx, "report.failed_to_start") }
				data-toast-failed-start-evaluation={ t(ctx, "report.failed_to_start_evaluation") }
				data-toast-evaluation-failed={ t(ctx, "report.rule_evaluation_failed") }
				data-toast-idle={ t(ctx, "report.rule_evaluation_idle") }
				data-toast-status-http-error={ t(ctx, "report.rule_status_http_error") }
				data-toast-status-network-error={ t(ctx, "report.rule_status_network_error") }
				data-msg-no-violations={ t(ctx, "report.violations_none") }
				data-msg-all-auto-fixed={ t(ctx, "report.violations_all_auto_fixed") }
				data-msg-violations-found={ t(ctx, "report.violations_found") }
				data-msg-violations-found-auto-fixed={ t(ctx, "report.violations_found_auto_fixed") }
				data-confirm-title={ t(ctx, "report.confirm_run_title") }
				data-confirm-body={ t(ctx, "report.confirm_run_body") }
				data-confirm-body-estimate={ t(ctx, "report.confirm_run_body_estimate") }
				data-confirm-accept={ t(ctx, "report.confirm_run_accept") }
				data-confirm-minute-one={ t(ctx, "report.confirm_minute.one") }
				data-confirm-minute-other={ t(ctx, "report.confirm_minute.other") }
				data-confirm-all-title={ t(ctx, "report.confirm_run_all_title") }
				data-confirm-all-body={ t(ctx, "report.confirm_run_all_body") }
				data-confirm-all-body-estimate={ t(ctx, "report.confirm_run_all_body_estimate") }
				data-confirm-all-accept={ t(ctx, "report.confirm_run_all_accept") }
				data-msg-evaluated-summary={ t(ctx, "report.evaluated_summary") }
				data-msg-evaluated-summary-all={ t(ctx, "report.evaluated_summary_all") }
				class="sw-rep-run-btn sw-rep-run-btn--primary"
			>
				<span id="run-rules-spinner" class="hidden">
					<svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
					</svg>
				</span>
				<span id="run-rules-label">{ t(ctx, "report.run_rules") }</span>
			</button>
			<button
				id="run-rules-all-btn"
				type="button"
				onclick="confirmAndRunRules('all')"
				title={ t(ctx, "report.run_rules_all_tooltip") }
				aria-controls="confirm-modal"
				aria-haspopup="dialog"
				class="sw-rep-run-btn"
			>
				{ t(ctx, "report.run_rules_all") }
			</button>
		</div>
	</div>
	<!-- Summary band (lazy-loaded from /api/v1/reports/health/by-library) -->
	<div
		id="compliance-summary"
		class="sw-rep-summary"
		hx-get="/api/v1/reports/health/by-library"
		hx-trigger="load"
		hx-swap="innerHTML"
	>
		<div class="sw-rep-summary-loading">
			<svg class="animate-spin sw-rep-spin-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
				<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
			</svg>
		</div>
	</div>
	<!-- Toolbar: search + filter trigger + column toggle + export -->
	<div class="sw-rep-toolbar">
		<div class="sw-rep-toolbar-search">
			<input
				type="search"
				id="compliance-search"
				name="search"
				data-sw-shortcut="/"
				data-sw-shortcut-label={ t(ctx, "reports.shortcuts.search") }
				value={ data.Search }
				placeholder={ t(ctx, "common.search_artists") }
				hx-get="/reports/compliance"
				hx-trigger="keyup changed delay:300ms, sortchanged"
				hx-target="#compliance-results"
				hx-swap="outerHTML"
				hx-include="[name='status'],[name='filter'],[name='library_id'],[name='sort'],[name='order'],[name='health_min'],[name='health_max']"
				class="sw-rep-search-input"
			/>
		</div>
		<div class="sw-rep-toolbar-actions">
			<button
				id="compliance-filter-trigger"
				type="button"
				data-sw-shortcut="f"
				data-sw-shortcut-label={ t(ctx, "reports.shortcuts.tip_filters") }
				class={ "sw-rep-filter-btn", templ.KV("is-active", repFilterCount(data) > 0) }
				data-active-classes="is-active"
				data-badge-classes="sw-filter-trigger-badge"
				aria-label={ t(ctx, "common.open_filter_panel") }
				aria-expanded="false"
				aria-controls="compliance-filter-flyout"
				onclick={ components.OpenFilterFlyout("compliance-filter-flyout") }
			>
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M2.628 1.601C5.028 1.206 7.49 1 10 1s4.973.206 7.372.601a.75.75 0 0 1 .628.74v2.288a2.25 2.25 0 0 1-.659 1.59l-4.682 4.683a2.25 2.25 0 0 0-.659 1.59v3.037c0 .684-.31 1.33-.844 1.757l-1.937 1.55A.75.75 0 0 1 9 18.25v-5.757a2.25 2.25 0 0 0-.659-1.591L3.659 6.22A2.25 2.25 0 0 1 3 4.629V2.34a.75.75 0 0 1 .628-.74Z" clip-rule="evenodd"></path>
				</svg>
				<span>{ t(ctx, "common.filters") }</span>
				if repFilterCount(data) > 0 {
					<span class="sw-filter-trigger-badge">{ fmt.Sprintf("%d", repFilterCount(data)) }</span>
				}
			</button>
			@components.ColumnToggle("compliance", "compliance-tbl", t(ctx, "common.columns"), false, []components.ColumnDef{
				{Key: "artist", Label: t(ctx, "reports.column_artist"), Required: true},
				{Key: "score", Label: t(ctx, "reports.column_score")},
				{Key: "metadata", Label: t(ctx, "reports.column_metadata")},
				{Key: "thumb", Label: img.ImageTermFor("thumb", data.ProfileName)},
				{Key: "fanart", Label: img.ImageTermFor("fanart", data.ProfileName)},
				{Key: "logo", Label: img.ImageTermFor("logo", data.ProfileName)},
				{Key: "mbid", Label: t(ctx, "reports.column_mbid")},
			})
			<a
				id="compliance-export-link"
				href={ templ.SafeURL(data.BasePath + "/api/v1/reports/compliance/export") }
				data-export-base={ data.BasePath + "/api/v1/reports/compliance/export" }
				onclick="rewriteComplianceExport(this)"
				class="sw-rep-export-btn"
			>
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
				</svg>
				{ t(ctx, "common.export_csv") }
			</a>
		</div>
	</div>
	<!-- Results | Matrix tab bar -->
	<div class="sw-rep-tabbar" role="tablist" aria-label={ t(ctx, "reports.tab_view_label") } id="sw-rep-tabbar">
		<button
			role="tab"
			aria-selected="true"
			aria-controls="sw-rep-tab-results"
			id="sw-rep-tab-btn-results"
			class="sw-rep-tab is-active"
			onclick="swRepTabSwitch('results')"
		>{ t(ctx, "reports.tab_results") }</button>
		<button
			role="tab"
			aria-selected="false"
			aria-controls="sw-rep-tab-matrix"
			id="sw-rep-tab-btn-matrix"
			class="sw-rep-tab"
			onclick="swRepTabSwitch('matrix')"
		>{ t(ctx, "reports.tab_matrix") }</button>
	</div>
	<!-- Tab panels: a SINGLE shared ComplianceResults shell (one #compliance-tbl /
	     #select-all in the DOM). swRepTabSwitch re-parents the shell between the
	     Results panel and the Matrix mount per active tab, so both tabs show the
	     same table and every HTMX refresh (which targets #compliance-results)
	     updates it regardless of which tab is active, removing the duplicate
	     IDs and the stale-data drift the second matrix render caused (#2079). -->
	<div class="sw-rep-tab-panels" id="sw-rep-tab-panels">
		<div
			id="sw-rep-tab-results"
			role="tabpanel"
			aria-labelledby="sw-rep-tab-btn-results"
			class="sw-rep-tab-panel"
		>
			@ComplianceResults(data)
		</div>
		<div
			id="sw-rep-tab-matrix"
			role="tabpanel"
			aria-labelledby="sw-rep-tab-btn-matrix"
			class="sw-rep-tab-panel hidden"
		>
			<!-- Mount point; swRepTabSwitch('matrix') moves #compliance-results here. -->
			<div class="sw-rep-matrix-scroll" id="sw-rep-matrix-mount"></div>
		</div>
	</div>
	<!-- Filter flyout (reused from stable compliance page) -->
	@ComplianceFilterFlyout(data)
	<!-- Bulk action bar -->
	<div
		id="bulk-action-bar"
		data-label-n-selected={ t(ctx, "report.n_selected") }
		class="fixed bottom-0 left-0 right-0 z-30 hidden bg-gray-900 dark:bg-gray-800 border-t border-gray-700 px-6 py-3"
	>
		<div class="max-w-7xl mx-auto flex items-center justify-between">
			<span
				id="bulk-count"
				class="text-sm text-white"
				data-zero-text={ t(ctx, "report.zero_selected") }
				data-one-text={ t(ctx, "report.one_selected") }
				data-many-template={ t(ctx, "report.n_selected") }
			>{ t(ctx, "report.zero_selected") }</span>
			<div class="flex items-center gap-3">
				<!-- #1757 PR-4 no-solid-blue sweep: the bar is dark in both themes,
				     so its action buttons take the dark-bar treatment the #1932
				     fanart bulk bar established (white ink + light-alpha outline)
				     instead of a solid blue fill. -->
				<button
					type="button"
					onclick="bulkAction('fetch-metadata')"
					class="inline-flex items-center gap-1.5 rounded-md border border-white/25 px-3 py-2 text-sm font-medium text-white hover:bg-white/10 transition-colors"
				>{ t(ctx, "report.fetch_metadata") }</button>
				<button
					type="button"
					onclick="bulkAction('fetch-images')"
					class="inline-flex items-center gap-1.5 rounded-md border border-white/25 px-3 py-2 text-sm font-medium text-white hover:bg-white/10 transition-colors"
				>{ t(ctx, "report.fetch_images") }</button>
				<button
					type="button"
					onclick="clearBulkSelection()"
					class="inline-flex items-center rounded-md bg-gray-700 px-3 py-2 text-sm text-gray-300 hover:bg-gray-600"
				>{ t(ctx, "common.cancel") }</button>
			</div>
		</div>
	</div>
	@repComplianceScript()
	@repRunRulesScript()
}

// repPanePlaceholder renders the right pane for reports that are not yet
// implemented. A placeholder empty state is shown with the report name.
templ repPanePlaceholder(ctx context.Context, reportID string) {
	<div class="sw-rep-placeholder">
		<svg class="sw-rep-placeholder-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"></path>
		</svg>
		<p class="sw-rep-placeholder-title">{ t(ctx, "reports.placeholder_title") }</p>
		<p class="sw-rep-placeholder-desc">{ t(ctx, "reports.placeholder_desc") }</p>
	</div>
}

// repPaneHealth renders the right pane for the Library health report. It
// embeds the existing HealthSummaryFragment (compliance score card + top
// failing rules + per-rule pass rates) used on the dashboard, so the reports
// workspace and the dashboard stay visually consistent without forking.
templ repPaneHealth(data HealthSummaryData) {
	<div class="sw-rep-pane-header">
		<div class="sw-rep-pane-title-block">
			<p class="sw-rep-pane-title">{ t(ctx, "reports.health_report.label") }</p>
			<p class="sw-rep-pane-desc">{ t(ctx, "reports.health_report.desc") }</p>
		</div>
	</div>
	<div class="sw-rep-simple-pane">
		@HealthSummaryFragment(data)
	</div>
}

// repPaneMetadataCompleteness renders the right pane for the Metadata
// completeness report by embedding the existing MetadataCompletenessFragment
// (field-coverage summary + lowest-completeness artist table).
templ repPaneMetadataCompleteness(report *artist.MetadataCompletenessReport) {
	<div class="sw-rep-pane-header">
		<div class="sw-rep-pane-title-block">
			<p class="sw-rep-pane-title">{ t(ctx, "reports.metadata_completeness.label") }</p>
			<p class="sw-rep-pane-desc">{ t(ctx, "reports.metadata_completeness.desc") }</p>
		</div>
	</div>
	<div class="sw-rep-simple-pane">
		@MetadataCompletenessFragment(report)
	</div>
}

// repPaneRulePassRates renders the right pane for the Rule pass-rates report.
// The /api/v1/reports/rule-pass-rates endpoint is JSON-only, so this pane
// renders an inline list directly from the loaded data. PassRate is a 0.0-1.0
// fraction (see rule.GetRulePassRates); it is shown as a whole percentage.
templ repPaneRulePassRates(rates []RulePassRateData) {
	<div class="sw-rep-pane-header">
		<div class="sw-rep-pane-title-block">
			<p class="sw-rep-pane-title">{ t(ctx, "reports.rule_pass_rates.label") }</p>
			<p class="sw-rep-pane-desc">{ t(ctx, "reports.rule_pass_rates.desc") }</p>
		</div>
	</div>
	<div class="sw-rep-simple-pane">
		if len(rates) == 0 {
			<p class="sw-rep-rate-empty">{ t(ctx, "reports.rule_pass_rates.empty") }</p>
		} else {
			<ul role="list" class="sw-rep-rate-list">
				for _, rt := range rates {
					<li class="sw-rep-rate-item">
						<span class="sw-rep-rate-name">{ rt.RuleName }</span>
						<span class="sw-rep-rate-counts">{ fmt.Sprintf("%d/%d", rt.Passed, rt.Evaluated) }</span>
						<span
							class={ "sw-rep-rate-pct",
								templ.KV("is-good", rt.PassRate >= 0.8),
								templ.KV("is-warn", rt.PassRate >= 0.5 && rt.PassRate < 0.8),
								templ.KV("is-bad", rt.PassRate < 0.5) }
						>{ fmt.Sprintf("%.0f%%", rt.PassRate*100) }</span>
					</li>
				}
			</ul>
		}
	</div>
}

// BlastRadiusData is the view model for the blast-radius report pane
// (issue #2750). It is assembled by loadReportsBlastRadiusData, which calls
// the same r.loadBlastRadius the JSON report and CSV export use, so the
// three surfaces cannot disagree about what was destroyed.
type BlastRadiusData struct {
	Rows       []artist.BlastRadiusRow
	Counts     artist.BlastRadiusCounts
	Pagination components.PaginationData
	// CutoffDate is the date scan-driven changes started recording
	// source="scan" distinctly (artist.AttributionCutoffDate). Rows before
	// it fall through to attribution=unknown. Informational prose only.
	CutoffDate string
	// CoveredFields and UncoveredFields are computed from
	// artist.TrackableFields() at request time (blastRadiusCoverage), never
	// hardcoded here, so the caveat cannot drift from the fields the report
	// can actually see.
	CoveredFields   []string
	UncoveredFields []string
	// Class, Attribution, Field and ArtistID mirror the active filter so the
	// pane can reflect current narrowing back to the operator.
	Class       string
	Attribution string
	Field       string
	ArtistID    string
	// Sort and Order mirror the active ordering. They are NOT narrowing axes
	// (see blastRadiusAxes): they reorder the same rows and never remove one,
	// so they are held apart from the four above and never reach
	// blastRadiusNarrowed.
	//
	// NO CONTROL SETS THEM ON THIS SLICE; the sort and order selects arrive with
	// the ordering slice. They are populated from the request here for two
	// reasons that are already live:
	//
	//   - blastRadiusPageURL below DOES carry them onto the pager links (it
	//     emits eight parameters: the four narrowing axes, sort, order,
	//     page_size and page). ?sort= and ?order= are hand-reachable today and
	//     the loader honours them, so without the carry an operator who reaches
	//     an ordered view walks to page 2 and the server falls back to its
	//     default, silently handing them the descending continuation of an
	//     ascending list.
	//   - the ordering slice's selects render the order actually in force
	//     rather than always showing the default.
	//
	// An earlier revision of this comment said the function emitted six
	// parameters and excluded sort/order. That was true of the parent slice and
	// this commit made it false; it is corrected here rather than left for a
	// reader to trip over.
	Sort     string
	Order    string
	BasePath string
}

// blastRadiusClassBadgeClass styles the damage-class badge.
//
// The pane previously reused historySourceBadgeClass here, which keys on a
// CHANGE SOURCE ("revert") and knows nothing about damage classes -- so blanked
// and replaced both fell through to the same gray and the badge distinguished
// nothing. The column exists to tell the two apart at a glance, which is what an
// operator triaging a damage report scans for.
//
// Red for blanked and amber for replaced, because they are not equally bad: a
// blanked field lost its value outright, while a replaced one still holds
// something (possibly correct). Neither is green -- both are damage.
//
// An unrecognized class gets the RED treatment rather than a neutral gray,
// matching blastRadiusRowClassLabel's own conservative default: on this surface
// an unknown state must not be styled as the milder one.
func blastRadiusClassBadgeClass(class string) string {
	if class == artist.BlastClassReplaced {
		return "bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300"
	}
	return "bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300"
}

// blastRadiusNarrowed and the axis table it walks live in
// blast_radius_filters.go, together with the active-filter count the trigger
// badge renders from the same table. They moved out of this file when the
// pane's narrowing model was made table-driven (#3093): the empty-state wording
// and the badge must agree about whether rows are being hidden, and keeping the
// model beside the markup that renders it hid that requirement.
//
// A THIRD reader of that table, the dismissable filter chips, arrives with the
// slice that renders them; it is not in this file or that one yet. See that
// file's header for why the model is a table rather than a chain of field
// comparisons.

// blastRadiusRowClassLabel and blastRadiusRowAttributionLabel key i18n
// lookups for the row-level class/attribution badges.
func blastRadiusRowClassLabel(ctx context.Context, class string) string {
	if class == artist.BlastClassReplaced {
		return t(ctx, "reports.blast_radius.class_replaced")
	}
	return t(ctx, "reports.blast_radius.class_blanked")
}

func blastRadiusRowAttributionLabel(ctx context.Context, attribution string) string {
	if attribution == artist.BlastAttributionAutomated {
		return t(ctx, "reports.blast_radius.attribution_automated")
	}
	return t(ctx, "reports.blast_radius.attribution_unknown")
}

// repPaneBlastRadius renders the right pane for the blast-radius report
// (issue #2750): which fields an automated writer blanked or overwrote, and
// per-row restore. Modeled on repPaneCompliance.
//
// Bulk selection is OWNED BY THIS PANE, not shared with compliance. An earlier
// cut emitted .bulk-select checkboxes, a select-all and a #bulk-action-bar whose
// handlers (toggleSelectAll/updateBulkBar/clearBulkSelection) are defined only
// inside repComplianceScript. The pane dispatch is an else-if chain, so on this
// pane that script never renders and every one of those handlers was an
// undefined function: ticking a box threw ReferenceError and the bar never
// unhid. The markup was removed rather than ship an inert control.
//
// The fix is NOT to hoist those three functions into a shared partial. Hoisting
// would give the selection logic TWO render surfaces to keep correct, and its
// selectors (.bulk-select, #select-all, #bulk-action-bar) are document-wide, so
// the two panes would cross-select the moment anything rendered both. Instead
// this pane carries its own blast-prefixed handlers in blastRadiusScript --
// the SAME partial that already ships blastRestoreRow, and which
// repPaneBlastRadius already renders unconditionally. Every handler referenced
// by this pane's markup is defined in a script this pane emits; the
// wiring test in internal/api asserts exactly that, so the ReferenceError
// defect cannot come back unnoticed.
//
// Selection markup uses .blast-select / #blast-select-all / #blast-bulk-bar --
// names disjoint from the compliance ones, so neither pane can reach the
// other's controls even if both were ever rendered together.
//
// The unknown-attribution count is always rendered next to the automated
// count (never hidden by a filter -- BlastRadiusCounts is computed without
// applying the attribution narrowing), and the coverage caveat is generated
// from data.CoveredFields/UncoveredFields, which the loader derives from
// artist.TrackableFields() at request time rather than a value baked into
// this template.
templ repPaneBlastRadius(data BlastRadiusData) {
	<div class="sw-rep-pane-header">
		<div class="sw-rep-pane-title-block">
			<!-- Context help sits on the TITLE of this pane specifically because
			     this is a destructive-recovery surface. The rules an operator
			     needs at the moment a restore is refused (that a preview is
			     not a promise, why a row can be refused, that refused rows stay
			     in the table) live in the docs, and an operator staring at a
			     refusal should not have to go search a docs site for them. The
			     anchor is validated by TestContextHelpAnchors against
			     web/components/_doc-anchors.txt, so a docs heading rename
			     fails CI rather than shipping a 404 "Read more".
			     Scope: blast radius only (#2750 UAT). The other report panes
			     deliberately do not carry one yet. -->
			<p class="sw-rep-pane-title">
				{ t(ctx, "reports.blast_radius.label") }
				@components.ContextHelp("help-blast-radius", t(ctx, "reports.blast_radius.label"), t(ctx, "reports.blast_radius.help"), "how-to/view-reports#putting-a-value-back")
			</p>
			<p class="sw-rep-pane-desc">{ t(ctx, "reports.blast_radius.desc") }</p>
		</div>
	</div>
	<!-- Mounts swContextHelpToggle/swContextHelpClose for the "?" icon above.
	     Layout does not mount them globally, and this pane is the only reports
	     pane that renders a ContextHelp, so the script belongs here rather
	     than on ReportsPage. The component self-guards re-injection. -->
	@components.ContextHelpScript()
	<!-- Everything a filter can change lives inside #blast-radius-pane, and the
	     filter reload replaces the whole container (#3093).
	     /reports/blast-radius has NO fragment handler. It returns the full page
	     whether or not HX-Request is set (verified: identical response length
	     and content both ways), so the reload pulls this container out of the
	     full-page response with hx-select rather than expecting a fragment.
	     The container is drawn around the CAVEAT BAND as well as the rows,
	     because the band reports the attribution split and the coverage lists
	     for the CURRENT filter. Swapping only the table would leave a caveat
	     band describing the previous request standing over fresh rows, which on
	     this surface is a wrong statement about how much was destroyed. The
	     active-filter chips and the trigger badge are inside for the same
	     reason: they are the operator's only signal that the table is short on
	     purpose.
	     The filter flyout itself is deliberately OUTSIDE, rendered after this
	     container, so a swap cannot yank the panel out from under an operator
	     who is still using it. -->
	<div id="blast-radius-pane">
		<!-- Attribution + coverage caveat band. Both counts are always shown side
	     by side (never just the automated headline), and the field lists are
	     rendered from data.CoveredFields/UncoveredFields, which the loader
	     computes from artist.TrackableFields() at request time. -->
		<div class="sw-rep-blast-caveat" role="note">
			<p class="sw-rep-blast-caveat-line">
				{ tf(ctx, "reports.blast_radius.attribution_summary",
				data.Counts.Automated, data.Counts.Unknown, data.CutoffDate) }
			</p>
			<p class="sw-rep-blast-caveat-line">
				{ tf(ctx, "reports.blast_radius.coverage_covered", strings.Join(data.CoveredFields, ", ")) }
			</p>
			if len(data.UncoveredFields) > 0 {
				<p class="sw-rep-blast-caveat-line">
					{ tf(ctx, "reports.blast_radius.coverage_uncovered", strings.Join(data.UncoveredFields, ", ")) }
				</p>
			}
			<p class="sw-rep-blast-caveat-line">{ t(ctx, "reports.blast_radius.retention_note") }</p>
		</div>
		<!-- Filter toolbar (#3093). Pane-local, exactly like the compliance pane's:
	     the two panes narrow on different axes, so a shared toolbar would have
	     to render controls that do nothing on whichever pane is active.
	     Before this, class/attribution/field/sort/order were reachable only by
	     hand-editing the URL, which on a 3,000-row damage report means the
	     operator gets an undifferentiated pile and no way to cut it down. -->
		<div class="sw-rep-toolbar">
			<div class="sw-rep-toolbar-actions">
				<button
					id="blast-radius-filter-trigger"
					type="button"
					class={ "sw-rep-filter-btn", templ.KV("is-active", blastRadiusFilterCount(data) > 0) }
					data-active-classes="is-active"
					data-badge-classes="sw-filter-trigger-badge"
					{ templ.Attributes{"data-server-filter-count": fmt.Sprintf("%d", blastRadiusFilterCount(data))}... }
					aria-label={ t(ctx, "common.open_filter_panel") }
					aria-expanded="false"
					aria-controls="blast-radius-filter-flyout"
					onclick={ components.OpenFilterFlyout("blast-radius-filter-flyout") }
				>
					<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path fill-rule="evenodd" d="M2.628 1.601C5.028 1.206 7.49 1 10 1s4.973.206 7.372.601a.75.75 0 0 1 .628.74v2.288a2.25 2.25 0 0 1-.659 1.59l-4.682 4.683a2.25 2.25 0 0 0-.659 1.59v3.037c0 .684-.31 1.33-.844 1.757l-1.937 1.55A.75.75 0 0 1 9 18.25v-5.757a2.25 2.25 0 0 0-.659-1.591L3.659 6.22A2.25 2.25 0 0 1 3 4.629V2.34a.75.75 0 0 1 .628-.74Z" clip-rule="evenodd"></path>
					</svg>
					<span>{ t(ctx, "common.filters") }</span>
					if blastRadiusFilterCount(data) > 0 {
						<span class="sw-filter-trigger-badge">{ fmt.Sprintf("%d", blastRadiusFilterCount(data)) }</span>
					}
				</button>
			</div>
		</div>
		<div class="overflow-x-auto" id="blast-radius-results">
			<table id="blast-radius-tbl" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
				<thead class="bg-gray-50 dark:bg-gray-800">
					<tr>
						<th scope="col" class="px-4 py-3 text-center w-10">
							<!-- Select-all covers ONLY the rows currently rendered. The pane
						     is server-paged, so there is no honest way to select rows this
						     page never fetched, and a control implying otherwise would
						     misreport the size of a destructive operation. The accessible
						     name sits on the input; the visible column header is the
						     sr-only span beside it. -->
							<input
								type="checkbox"
								id="blast-select-all"
								onchange="blastToggleSelectAll(this)"
								class="rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500"
								aria-label={ t(ctx, "reports.blast_radius.select_all_rows") }
							/>
							<span class="sr-only">{ t(ctx, "reports.blast_radius.select_column") }</span>
						</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.column_artist") }</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.blast_radius.column_field") }</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.blast_radius.column_change") }</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.blast_radius.column_class") }</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.blast_radius.column_attribution") }</th>
						<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.blast_radius.column_when") }</th>
						<th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.blast_radius.column_restore") }</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
					if len(data.Rows) == 0 {
						<tr>
							<td colspan="8" class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
								// Two DIFFERENT statements, because only one of them is ever
								// true. "Nothing recorded" is a claim about the whole library
								// and is false the moment a filter is narrowing the view: an
								// operator who filters to a field with no damage would
								// otherwise read an all-clear over a library that still holds
								// destroyed values, which is the exact failure this pane exists
								// to prevent. blastRadiusNarrowed reports whether any narrowing
								// is active.
								//
								// THE NUMBER QUOTED IS TotalUnfiltered, NOT Total. Total is the
								// pagination denominator, scoped to the CURRENT narrowing -- and
								// this branch renders only when that narrowing matched nothing,
								// so Total is zero by construction. Quoting it produced "the
								// report still records 0 change(s) overall" on every filtered
								// empty state, including one measured over a library holding 12
								// unattributable destroyed values while the caveat band a few
								// pixels above correctly said "12 of unknown origin". The pane
								// contradicted itself in adjacent elements and the reassuring
								// half was the one in the table.
								//
								// Automated+Unknown is not a substitute: those ignore the
								// attribution filter but still follow class, field and
								// artist_id (see BlastRadiusCounts), so under any of those axes
								// they are not library-wide either. TotalUnfiltered is counted
								// with every axis dropped, which is what makes this sentence
								// true.
								if blastRadiusNarrowed(data) {
									{ tf(ctx, "reports.blast_radius.empty_filtered", data.Counts.TotalUnfiltered) }
								} else {
									{ t(ctx, "reports.blast_radius.empty") }
								}
							</td>
						</tr>
					}
					for _, row := range data.Rows {
						@blastRadiusRow(row)
					}
				</tbody>
			</table>
		</div>
		@blastRadiusPagination(data)
	</div>
	<!-- Bulk action bar. Rendered hidden and revealed by blastUpdateBulkBar
	     once at least one row is selected.

	     The live region is #blast-bulk-count ALONE, not this wrapper.
	     role="status" implies aria-atomic="true", so putting it on the bar
	     re-announced the bar's ENTIRE subtree on every selection change:
	     "3 rows selectedRestore Selected Cancel". Ticking 20 rows meant 20
	     announcements each ending in the button labels. Scoped to the count,
	     the reveal still ANNOUNCES itself (a keyboard or screen-reader user
	     who ticks a checkbox otherwise gets no signal that a new destructive
	     control appeared below the table) and each change announces only the
	     number that changed. The script sets the count only AFTER unhiding,
	     because a live region mutated while display:none announces nothing.

	     The bar is in normal document order after the table, so it is
	     reachable by Tab and escapable by Tab (not a focus trap), and
	     deliberately does not move focus on reveal, which would yank a user
	     out of the row list mid-selection. It DOES move focus out on hide;
	     see blastUpdateBulkBar. -->
	<div
		id="blast-bulk-bar"
		class="hidden fixed bottom-0 left-0 right-0 z-30 bg-gray-900 dark:bg-gray-800 border-t border-gray-700 px-6 py-3"
	>
		<div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
			<span
				id="blast-bulk-count"
				role="status"
				aria-live="polite"
				class="text-sm text-white"
				data-one-text={ t(ctx, "reports.blast_radius.one_selected") }
				data-many-template={ t(ctx, "reports.blast_radius.n_selected") }
			></span>
			<div class="flex items-center gap-3">
				<!-- Preview, never commit. This button issues the commit:false dry
				     run; the confirm dialog it opens is the second affirmative
				     action that commits. Same two-step blastRestoreRow uses. -->
				<button
					type="button"
					onclick="blastRestoreSelected()"
					class="inline-flex items-center gap-1.5 rounded-md border border-white/25 px-3 py-2 text-sm font-medium text-white hover:bg-white/10 transition-colors"
				>{ t(ctx, "reports.blast_radius.restore_selected") }</button>
				<button
					type="button"
					onclick="blastClearSelection()"
					class="inline-flex items-center rounded-md bg-gray-700 px-3 py-2 text-sm text-gray-300 hover:bg-gray-600"
				>{ t(ctx, "common.cancel") }</button>
			</div>
		</div>
	</div>
	<!-- i18n strings for blastRadiusScript. JS has no access to the request
	     translator, so every user-facing string the script renders (toasts,
	     confirm-dialog copy, plan summaries) is passed through this hidden
	     element rather than hardcoded in the script block. -->
	<div
		id="blast-radius-i18n"
		hidden
		data-restore-failed={ t(ctx, "reports.blast_radius.js.restore_failed") }
		data-restore-conflict={ t(ctx, "reports.blast_radius.js.restore_conflict") }
		data-network-error={ t(ctx, "reports.blast_radius.js.network_error") }
		data-filter-reload-failed={ t(ctx, "reports.blast_radius.js.filter_reload_failed") }
		data-filter-badge-one={ t(ctx, "reports.blast_radius.js.filter_badge_one") }
		data-filter-badge-many={ t(ctx, "reports.blast_radius.js.filter_badge_many") }
		data-plan-summary={ t(ctx, "reports.blast_radius.js.plan_summary") }
		data-plan-refused={ t(ctx, "reports.blast_radius.js.plan_refused") }
		data-restored-count={ t(ctx, "reports.blast_radius.js.restored_count") }
		data-restore-partial={ t(ctx, "reports.blast_radius.js.restore_partial") }
		data-restore-none={ t(ctx, "reports.blast_radius.js.restore_none") }
		data-restore-nothing={ t(ctx, "reports.blast_radius.js.restore_nothing") }
		data-restore-unchanged={ t(ctx, "reports.blast_radius.js.restore_unchanged") }
		data-confirm-title={ t(ctx, "reports.blast_radius.js.confirm_title") }
		data-confirm-accept={ t(ctx, "reports.blast_radius.js.confirm_accept") }
		data-confirm-title-bulk={ t(ctx, "reports.blast_radius.js.confirm_title_bulk") }
		data-refused-label={ t(ctx, "reports.blast_radius.js.refused_label") }
		data-refuse-change-not-found={ t(ctx, "reports.blast_radius.js.refuse_change_not_found") }
		data-refuse-not-revertible={ t(ctx, "reports.blast_radius.js.refuse_not_revertible") }
		data-refuse-revert-of-revert={ t(ctx, "reports.blast_radius.js.refuse_revert_of_revert") }
		data-refuse-no-longer-current={ t(ctx, "reports.blast_radius.js.refuse_no_longer_current") }
		data-refuse-restore-failed={ t(ctx, "reports.blast_radius.js.refuse_restore_failed") }
		data-refuse-old-value-invalid={ t(ctx, "reports.blast_radius.js.refuse_old_value_invalid") }
		data-refuse-name-collision={ t(ctx, "reports.blast_radius.js.refuse_name_collision") }
		data-refuse-unknown={ t(ctx, "reports.blast_radius.js.refuse_unknown") }
	></div>
	@blastRadiusFilterFlyout(data)
	@blastRadiusFilterScript()
	@blastRadiusScript()
}

// blastRadiusFilterFlyout renders the pane's filter panel (#3093).
//
// Only the axes the query layer already honours are offered: class,
// attribution and field. Nothing here invents a filter the server would ignore
// -- a control that appears to narrow and does not is worse on this surface
// than no control, because the operator reads the resulting row set as the
// answer to a question that was never asked.
//
// THE FIELD SECTION IS GENERATED, NEVER WRITTEN OUT. data.CoveredFields IS
// artist.TrackableFields() as the loader computed it for this request
// (blastRadiusCoverage), the same slice the coverage caveat above the table
// quotes. A hand-written list would drift the moment a field is added to
// history tracking, and it would drift SILENTLY: the missing option simply
// never appears, so damage to that field stays unfilterable while the caveat
// band claims the report covers it.
//
// artist_id has no control. It is a UUID; a select over every artist in the
// library is not a usable control and a free-text box for a UUID is not either.
// It stays reachable by deep link and IS rendered as a dismissable chip when
// set, so an operator who arrives through one can see it and clear it.
templ blastRadiusFilterFlyout(data BlastRadiusData) {
	@components.FilterFlyout("blast-radius-filter-flyout", t(ctx, "reports.blast_radius.filters_title"), "blast-radius-filter-trigger", blastRadiusFilterCount(data), "#blast-radius-results", nil) {
		@components.FilterSection(t(ctx, "reports.blast_radius.column_class")) {
			@components.FilterItemSingle("blast-radius-filter-flyout", "class", artist.BlastClassBlanked, t(ctx, "reports.blast_radius.class_blanked"), data.Class == artist.BlastClassBlanked, 0)
			@components.FilterItemSingle("blast-radius-filter-flyout", "class", artist.BlastClassReplaced, t(ctx, "reports.blast_radius.class_replaced"), data.Class == artist.BlastClassReplaced, 0)
		}
		@components.FilterSection(t(ctx, "reports.blast_radius.column_attribution")) {
			@components.FilterItemSingle("blast-radius-filter-flyout", "attribution", artist.BlastAttributionAutomated, t(ctx, "reports.blast_radius.attribution_automated"), data.Attribution == artist.BlastAttributionAutomated, 0)
			@components.FilterItemSingle("blast-radius-filter-flyout", "attribution", artist.BlastAttributionUnknown, t(ctx, "reports.blast_radius.attribution_unknown"), data.Attribution == artist.BlastAttributionUnknown, 0)
		}
	}
}

// blastRadiusFilterScript wires the pane's filter controls to a reload.
//
// TWO ENTRY POINTS, ONE RELOAD. The flyout's Apply writes the chosen params to
// the URL and fires sw:filter-applied at #blast-radius-results (filter-flyout.js);
// the sort/order selects change the URL themselves. Both then call the same
// reload, so a filter and a re-sort cannot diverge in how they rebuild the
// request.
//
// The reload targets /reports/blast-radius, which serves the WHOLE pane rather
// than a fragment: unlike /reports/compliance there is no fragment handler for
// this report, and the pane's caveat band (the attribution split and the
// coverage lists) sits ABOVE the results table and moves with the filter. A
// swap scoped to the table alone would leave a stale caveat band standing over
// fresh rows, which on this surface is a wrong statement about how much was
// destroyed. hx-select pulls the pane's whole container out of the full-page
// response, so the swap replaces everything that can change together.
//
// NO SILENT-FAILURE GUARDS. Both htmx and swFilterFlyout are loaded globally by
// the layout, so their absence is a broken page, not a supported configuration.
// Each check reports loudly and then does nothing rather than falling back to a
// half-working path: on a recovery surface, a filter that silently does not
// apply leaves the operator reading an unfiltered table as though it were the
// filtered one.
templ blastRadiusFilterScript() {
	<script>
		// blastRadiusReload re-requests the pane with the current URL's query
		// string. window.location.search is the single source of truth: the
		// flyout has already written its params there, and the selects write
		// theirs below, so neither has to know what the other set.
		function blastRadiusReload() {
			if (!window.htmx) {
				console.error('blast-radius: htmx is not loaded; the filter controls cannot reload the report');
				return;
			}
			// The path stays ROOT-RELATIVE. layout.templ installs a global
			// htmx:configRequest listener that prepends the base path to every
			// root-relative htmx path, so prefixing it here would produce
			// /base/base/reports/blast-radius under SW_BASE_PATH. The
			// compliance pane uses the same idiom.
			//
			// THE REJECTION IS HANDLED, because nothing else handles it.
			// layout.templ covers htmx:responseError and htmx:timeout, and
			// htmx.ajax RESOLVES on any HTTP response including a 5xx, so those
			// two cover every case where the request reached the server. A
			// NETWORK failure -- server down, DNS, connection dropped mid-flight
			// -- rejects the promise instead, and no handler anywhere sees it.
			//
			// Unhandled, the operator applies a filter, the URL updates through
			// pushState, the request never lands, and the pane goes on rendering
			// the PREVIOUS filter's rows under the NEW URL with nothing said.
			// The caveat band and the row set then describe a filter the
			// operator is no longer looking at: the same stale-state falsehood
			// the swap boundary guards against, arriving over the network.
			//
			// showToast is the idiom the global handlers already use, so a
			// network failure reads the same as an HTTP one. console.error as
			// well, because a page whose toast container failed to render must
			// not swallow the failure silently -- the same belt-and-braces
			// blastRestoreRequest uses. No timeout handling is added here:
			// htmx:timeout is global and already toasts, and a second handler
			// would report the same timeout twice.
			return htmx.ajax('GET', '/reports/blast-radius' + window.location.search, {
				target: '#blast-radius-pane',
				swap: 'outerHTML',
				select: '#blast-radius-pane'
			}).catch(function(err) {
				console.error('blast-radius: the filter reload did not reach the server', err);
				// The copy comes from #blast-radius-i18n, the pane's own hidden
				// element, for the reason every other string in this script
				// does: JS has no access to the request translator, so a
				// hardcoded English literal would be the one untranslated
				// sentence on the pane.
				var el = document.getElementById('blast-radius-i18n');
				var msg = el && el.dataset ? el.dataset.filterReloadFailed : '';
				if (typeof showToast === 'function') {
					showToast(msg || 'The filtered report could not be loaded. The rows below still show the previous filter.');
				} else {
					// showToast is installed by the layout, so its absence is a
					// broken page rather than a supported configuration -- and a
					// failure the operator never sees is the defect this whole
					// handler exists to prevent.
					console.error('blast-radius: showToast is not available, so the filter-reload failure reached nobody');
				}
			});
		}

		// The flyout's Apply fires sw:filter-applied at its data-target-sel.
		// Bound on document.body rather than on the results container because
		// the container is REPLACED by every swap, which would take a listener
		// bound to it with it and leave the second filter application dead.
		document.body.addEventListener('sw:filter-applied', function(evt) {
			if (!evt.target || evt.target.id !== 'blast-radius-results') return;
			blastRadiusReload();
		});

		// Hydrate the flyout chips from the URL on first paint, so a deep link or
		// a reload shows the filters that are actually in force rather than an
		// empty panel over a narrowed table.
		//
		// THEN PUT THE SERVER'S BADGE COUNT BACK, because hydration is entitled to
		// set the chips but NOT to answer "how much is hidden".
		//
		// initFromURL's last act is refreshActiveCount, which counts controls
		// INSIDE the panel. blastRadiusFilterCount counts AXES -- class,
		// attribution, field and artist_id -- and the flyout does not render a
		// control for every one of them. artist_id has none by design (it is a
		// UUID; a select over every artist is not a usable control) and arrives by
		// deep link from artist detail. So the panel's control count is a LOWER
		// BOUND on the narrowing, and letting it overwrite the badge understates
		// how much of the report is hidden.
		//
		// Measured on this slice: ?field=biography&class=blanked renders a correct
		// badge of 2, hydration recounts the panel, finds 1, and overwrites it; on
		// ?field=biography alone the badge is 1 and hydration erases it entirely.
		//
		// This is D-F2 in its third form. First it was an EMPTY panel zeroing the
		// badge (fixed by skipping hydration while the panel had no axes); now it
		// is a PARTIAL panel undercounting it. Both are the same operator-facing
		// lie: a deep link narrows a multi-thousand-row damage report, the table
		// shows a subset, and the trigger understates or omits the count -- so
		// nothing on the pane says rows are being hidden and the operator reads the
		// short table as the whole report.
		//
		// THE SERVER'S NUMBER IS AUTHORITATIVE and is carried on the trigger as
		// data-server-filter-count, written from the same blastRadiusFilterCount
		// the badge itself renders from -- one source of truth, not a reimplemented
		// count in JS that could drift from the axis table. Restoring it after
		// initFromURL is deliberately a pane-local fix: refreshActiveCount is
		// shared by five panes (artists, activity, logs, index, this one) whose
		// flyouts DO render a control per axis, and changing it for them to fix a
		// property only this pane has would be the wrong blast radius.
		//
		// The skip below stays for the no-axis case, which is what the shell
		// renders before any axis lands: hydration is a no-op there and
		// refreshActiveCount would zero a correct badge. It keys on whether the
		// flyout body rendered ANY children rather than on a count of one attribute
		// name, so an axis built from a different control type still counts. A
		// MISSING panel or body is a broken component, not an empty panel, so it
		// reports loudly rather than skipping.
		// blastFilterBadgeLabel builds the badge's accessible name from the
		// TRANSLATED strings on #blast-radius-i18n.
		//
		// This was two English literals ('1 active filter' / n + ' active
		// filters'), which made it the ONLY user-facing string in this script not
		// read from that element -- the exact thing the comment on
		// blastRestoreI18n forbids, and for the exact reason it gives: JS has no
		// access to the request translator, so a literal here is the one
		// untranslated sentence on the pane. The visible badge is a bare number, so
		// this label is the ONLY form the count takes for a screen-reader user --
		// leaving it English means those users, and only those users, lose the
		// translation on the one control that says how much of the damage report is
		// hidden.
		//
		// The element is read directly rather than through blastRestoreI18n, which
		// lives in a DIFFERENT script block (blastRadiusScript). Nothing else in
		// this block reaches across that boundary, and introducing the first such
		// call would make this block depend on the other one being rendered -- a
		// coupling that buys nothing over the two lines below.
		//
		// {count} interpolation matches the plural pattern the rest of the pane
		// uses (see #blast-bulk-count's data-many-template). English fallbacks stay
		// in the || position: a missing dataset entry should degrade to a readable
		// label, not to "undefined".
		function blastFilterBadgeLabel(n) {
			var el = document.getElementById('blast-radius-i18n');
			var i18n = el && el.dataset ? el.dataset : {};
			if (n === 1) {
				return i18n.filterBadgeOne || '1 active filter';
			}
			return (i18n.filterBadgeMany || '{count} active filters').replace('{count}', String(n));
		}

		function blastRestoreServerFilterCount() {
			var trigger = document.getElementById('blast-radius-filter-trigger');
			if (!trigger) {
				console.error('blast-radius: #blast-radius-filter-trigger is missing; the active-filter count cannot be restored');
				return;
			}
			var raw = trigger.getAttribute('data-server-filter-count');
			var n = parseInt(raw, 10);
			if (isNaN(n)) {
				// Loud, not silent: without the server's number this pane cannot
				// state how much is hidden, and a silently wrong badge is the
				// defect this whole function exists to prevent.
				console.error('blast-radius: the trigger carries no readable data-server-filter-count, so the active-filter badge may understate the narrowing', raw);
				return;
			}
			var badge = trigger.querySelector('.sw-filter-trigger-badge');
			if (n > 0) {
				if (!badge) {
					badge = document.createElement('span');
					badge.className = trigger.getAttribute('data-badge-classes') || 'sw-filter-trigger-badge';
					trigger.appendChild(badge);
				}
				badge.textContent = String(n);
				badge.setAttribute('aria-label', blastFilterBadgeLabel(n));
				badge.style.display = '';
				trigger.classList.add('is-active');
			} else if (badge) {
				badge.style.display = 'none';
				trigger.classList.remove('is-active');
			}
		}

		document.addEventListener('DOMContentLoaded', function() {
			if (!window.swFilterFlyout) {
				console.error('blast-radius: swFilterFlyout is not loaded; the filter panel cannot show which filters are active');
				return;
			}
			var panel = document.getElementById('blast-radius-filter-flyout');
			if (!panel) {
				console.error('blast-radius: #blast-radius-filter-flyout is missing; the filter panel cannot be hydrated');
				return;
			}
			var body = panel.querySelector('.sw-filter-flyout-body');
			if (!body) {
				console.error('blast-radius: the filter panel has no .sw-filter-flyout-body; its contents cannot be inspected and hydration would run blind');
				return;
			}
			if (body.children.length === 0) {
				return;
			}
			swFilterFlyout.initFromURL('blast-radius-filter-flyout');
			blastRestoreServerFilterCount();
		});
	</script>
}

// blastRadiusRow renders one destroyed field: artist, field, old -> new
// value, damage class, attribution (always shown, per row, so a bulk restore
// over a mixed selection is a visibly informed choice), timestamp, and a
// per-row restore action.
templ blastRadiusRow(row artist.BlastRadiusRow) {
	<tr id={ "blast-row-" + row.ID } class="hover:bg-gray-50 dark:hover:bg-gray-800">
		<td class="px-4 py-3 text-center">
			<!-- value is the metadata_changes id, which is exactly what the
			     restore endpoint takes as change_ids. The per-row name repeats
			     the artist and field so a screen-reader user hears WHICH value
			     they are selecting rather than "checkbox" seven times. -->
			<input
				type="checkbox"
				class="blast-select rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500"
				value={ row.ID }
				onchange="blastUpdateBulkBar()"
				aria-label={ tf(ctx, "reports.blast_radius.select_row", row.ArtistName, historyFieldLabel(ctx, row.Field)) }
			/>
		</td>
		<td class="px-4 py-3 text-sm">{ row.ArtistName }</td>
		<td class="px-4 py-3 text-sm">{ historyFieldLabel(ctx, row.Field) }</td>
		<td class="px-4 py-3 text-sm">
			if row.OldValue != "" {
				<!-- text-red-600, not text-red-500: on the light-theme white row
				     background red-500 (#fb2c36) computes to 3.81:1, below the
				     4.5:1 WCAG AA floor for this 14px body text. red-600
				     (#e7000b) measures 4.77:1 and clears it. Verified as a
				     rendered contrast failure by the blast-radius a11y spec in
				     both Firefox and Chromium; text-red-600 dark:text-red-400 is
				     also the most common pairing already in these templates. -->
				<span class="line-through text-red-600 dark:text-red-400 mr-1">{ historyTruncate(row.OldValue, 60) }</span>
			}
			if row.NewValue != "" {
				<span class="text-gray-600 dark:text-gray-400">{ historyTruncate(row.NewValue, 60) }</span>
			} else {
				<span class="text-gray-600 dark:text-gray-400 italic">{ t(ctx, "history.cleared") }</span>
			}
		</td>
		<td class="px-4 py-3 text-sm">
			<span class={ "inline-block px-2 py-0.5 rounded-full text-xs", blastRadiusClassBadgeClass(row.Class) }>
				{ blastRadiusRowClassLabel(ctx, row.Class) }
			</span>
		</td>
		<td class="px-4 py-3 text-sm">
			<span
				class={ "inline-block px-2 py-0.5 rounded-full text-xs",
					templ.KV("bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300", row.Attribution == artist.BlastAttributionUnknown),
					templ.KV("bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300", row.Attribution != artist.BlastAttributionUnknown) }
				data-attribution={ row.Attribution }
			>
				{ blastRadiusRowAttributionLabel(ctx, row.Attribution) }
			</span>
		</td>
		<td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">
			<time datetime={ row.CreatedAt.Format(time.RFC3339) } title={ row.CreatedAt.Format("2006-01-02 15:04:05 UTC") }>
				{ historyTimeAgo(ctx, row.CreatedAt) }
			</time>
		</td>
		<td class="px-4 py-3 text-right">
			<button
				type="button"
				onclick={ templ.JSFuncCall("blastRestoreRow", row.ID) }
				class="text-xs px-2 py-1 rounded border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
				title={ t(ctx, "reports.blast_radius.restore_row_title") }
			>
				{ t(ctx, "reports.blast_radius.restore") }
			</button>
			<!-- Per-row refusal reason, filled in by blastApplyRefusalReasons
			     from the response's refuse_reason. Empty and hidden until the
			     server refuses THIS row.

			     It lives here rather than in the toast because a refusal is a
			     property of one row: a bulk restore can refuse several rows for
			     several different reasons at once, and a single toast can only
			     ever name one of them (which is how the generic toast came to
			     assert "already changed since this report loaded" for every
			     refusal, including collisions, where it is simply false).
			     Refused rows deliberately STAY in the table, so the row is
			     still on screen to carry its own reason.

			     DELIBERATELY NOT A LIVE REGION. role="status" here would be the
			     obvious move and it is the wrong one: the pane is server-paged
			     at up to 500 rows (getUserPageSize clamps to [10, 500]), so a
			     per-row live region means up to 500 of them on one page, and a
			     bulk restore that refuses many rows would queue one polite
			     announcement per refusal with no way to interrupt. The
			     announcement is already made ONCE, by the toast
			     (#error-toast-container is role="status" aria-live="polite" in
			     layout.templ), which reports the counts; this text is the
			     per-row detail a reader reaches by reading the row, exactly
			     like every other cell in the table.

			     Rendered empty on page load rather than created on demand so
			     the JS only ever writes text into an element that already
			     exists. It carries .hidden while empty so an empty paragraph
			     never takes vertical space in the action cell. -->
			<p
				id={ "blast-reason-" + row.ID }
				class="hidden mt-1 text-xs text-left text-amber-700 dark:text-amber-300"
			></p>
		</td>
	</tr>
}

// blastRadiusPageURL builds a pager link that carries the ENTIRE view forward:
// the base path, every active filter, and the page size.
//
// Dropping any of them is a data-honesty bug on this surface, not a cosmetic
// one. A link of bare ?page=N re-resolves page size from the stored preference,
// so paging from a 10-row page 1 to a 50-row page 2 skips rows 11-50 outright --
// the operator pages forward, sees no gap, and never learns those destroyed
// values exist. Dropping the filters is the mirror failure: page 2 silently
// widens to the unfiltered report while the caption still describes the narrowed
// one.
//
// BasePath is required because the pane is reachable under SW_BASE_PATH; an
// absolute /reports/... link 404s behind a reverse proxy, leaving the operator
// no way forward except editing the URL by hand.
//
// url.Values is used rather than string concatenation so a field name or artist
// id containing & or = cannot break out of its parameter.
func blastRadiusPageURL(data BlastRadiusData, page int) string {
	q := url.Values{}
	if data.Class != "" {
		q.Set("class", data.Class)
	}
	if data.Attribution != "" {
		q.Set("attribution", data.Attribution)
	}
	if data.Field != "" {
		q.Set("field", data.Field)
	}
	if data.ArtistID != "" {
		q.Set("artist_id", data.ArtistID)
	}
	// Ordering travels with the page link too (#3093). Without it, walking to
	// page 2 from an artist-name-sorted view silently reverts to the default
	// newest-first order, so the operator gets rows that are not the
	// continuation of the ones they were reading.
	if data.Sort != "" {
		q.Set("sort", data.Sort)
	}
	if data.Order != "" {
		q.Set("order", data.Order)
	}
	// Always explicit: an omitted page_size falls back to the stored preference,
	// which is exactly how rows go missing between pages of different sizes.
	q.Set("page_size", strconv.Itoa(data.Pagination.PageSize))
	q.Set("page", strconv.Itoa(page))
	return data.BasePath + "/reports/blast-radius?" + q.Encode()
}

// blastRadiusPagination renders a plain (non-HTMX) prev/next pager for the
// blast-radius pane. components.Pagination is not reused here: its links
// carry hx-get/hx-target against a fragment endpoint, and /reports/blast-radius
// has no such fragment handler (unlike /reports/compliance) -- reusing it
// would target a swap that never responds. A full-page navigation link is
// correct for this pane's current scope.
templ blastRadiusPagination(data BlastRadiusData) {
	if data.Pagination.TotalPages > 1 {
		<!-- id is a structural hook, not decoration: the pager's page numbers and
		     its prev/next hrefs are computed from the ACTIVE filter, so it has to
		     sit inside #blast-radius-pane or a filter change leaves a pager
		     describing the previous row set. The swap-contract test asserts that
		     boundary by id, because the only other stable handles here are the
		     translated aria-label and the Tailwind class list. -->
		<nav
			id="blast-radius-pager"
			class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 px-4 py-3"
			aria-label={ t(ctx, "reports.blast_radius.pager_label") }
		>
			<p class="text-sm text-gray-700 dark:text-gray-300">
				{ tf(ctx, "reports.blast_radius.page_of", data.Pagination.CurrentPage, data.Pagination.TotalPages) }
			</p>
			<div class="flex gap-2">
				if data.Pagination.CurrentPage > 1 {
					<a
						href={ templ.SafeURL(blastRadiusPageURL(data, data.Pagination.CurrentPage-1)) }
						class="relative inline-flex items-center rounded-md bg-white dark:bg-gray-800 px-3 py-2 text-sm font-semibold text-gray-900 dark:text-gray-100 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700"
					>{ t(ctx, "common.previous") }</a>
				}
				if data.Pagination.CurrentPage < data.Pagination.TotalPages {
					<a
						href={ templ.SafeURL(blastRadiusPageURL(data, data.Pagination.CurrentPage+1)) }
						class="relative inline-flex items-center rounded-md bg-white dark:bg-gray-800 px-3 py-2 text-sm font-semibold text-gray-900 dark:text-gray-100 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700"
					>{ t(ctx, "common.next") }</a>
				}
			</div>
		</nav>
	}
}

// blastRadiusScript renders the JS for the blast-radius pane: single-row and
// bulk restore against POST {basePath}/api/v1/reports/blast-radius/restore.
// Every request previews first (commit:false) and shows the plan in a
// confirm dialog; only an explicit accept re-issues the request with
// commit:true. Restore does not imply the field will never be looked at
// again -- the write stamps dirty_since, so the next incremental rule pass
// re-evaluates the artist (handlers_blast_radius_restore.go) -- so this
// script never renders copy claiming a stronger guarantee than that.
templ blastRadiusScript() {
	<script>
		function blastRestoreBasePath() {
			var el = document.querySelector('meta[name="htmx-base-path"]');
			return el ? el.content : '';
		}

		function blastRestoreCSRF() {
			var m = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/);
			return m ? m[1] : '';
		}

		// blastRestoreI18n reads the hidden #blast-radius-i18n element
		// rendered by repPaneBlastRadius. JS has no access to the request
		// translator, so every user-facing string this script renders comes
		// from here rather than a hardcoded English literal.
		function blastRestoreI18n() {
			var el = document.getElementById('blast-radius-i18n');
			return el ? el.dataset : {};
		}

		// blastRestoreRequest posts to the restore endpoint. commit=false is a
		// preview that writes nothing; commit=true performs the write. Reports
		// a plain-language toast summarizing the outcome; a failed request
		// surfaces via console.error in addition to the toast so a missing
		// toast container never silently swallows the failure.
		function blastRestoreRequest(ids, commit, onSuccess) {
			if (!ids.length) return;
			var i18n = blastRestoreI18n();
			fetch(blastRestoreBasePath() + '/api/v1/reports/blast-radius/restore', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': blastRestoreCSRF() },
				body: JSON.stringify({ change_ids: ids, commit: commit })
			}).then(function(resp) {
				if (resp.status === 409) {
					showToast(i18n.restoreConflict || 'Another restore is already running.');
					return null;
				}
				// Read as TEXT and parse defensively. The restore endpoint answers
				// some failures with http.Error, which writes plain text -- and a
				// bare resp.json() rejects on that, sending a server-side refusal
				// into the .catch below where it is reported as a NETWORK error.
				// On a recovery surface that is the wrong diagnosis: it tells the
				// operator their connection failed when the server answered.
				return resp.text().then(function(text) {
					var data = null;
					try {
						data = text ? JSON.parse(text) : null;
					} catch (e) {
						// Deliberately swallowed: an unparsable body is reported
						// through the status branches below, which say what the
						// server actually returned. Logged, never silent.
						console.error('blast-radius restore returned a non-JSON body', resp.status, text);
					}
					return { status: resp.status, body: data };
				});
			}).then(function(result) {
				if (!result) return;
				if (result.status < 200 || result.status >= 300) {
					console.error('blast-radius restore failed', result.status, result.body);
					showToast((i18n.restoreFailed || 'Restore request failed (HTTP {status})').replace('{status}', result.status));
					return;
				}
				// A 2xx whose body did not parse is NOT a success to act on: the
				// caller counts restored rows from it, and treating an unreadable
				// body as an empty result would report "0 restored" for a restore
				// that may well have happened.
				if (!result.body) {
					console.error('blast-radius restore returned an unreadable success body', result.status);
					showToast((i18n.restoreFailed || 'Restore request failed (HTTP {status})').replace('{status}', result.status));
					return;
				}
				onSuccess(result.body);
			}).catch(function(err) {
				console.error('blast-radius restore network error', err);
				showToast(i18n.networkError || 'Network error while restoring');
			});
		}

		// blastRestorePlanSummary turns a plan response into a human-readable
		// confirmation line, naming refusals explicitly rather than only the
		// eligible count -- a partial plan must not read as a clean one.
		function blastRestorePlanSummary(plan) {
			var i18n = blastRestoreI18n();
			var msg = (i18n.planSummary || '{eligible} of {requested} selected change(s) can be restored.')
				.replace('{eligible}', plan.eligible).replace('{requested}', plan.requested);
			if (plan.refused > 0) {
				msg += ' ' + (i18n.planRefused || '{refused} cannot be restored.').replace('{refused}', plan.refused);
			}
			return msg;
		}

		// blastRefusalText turns a machine-readable refuse_reason token into the
		// prose an operator is shown. Every branch says what to DO, not only
		// what happened, because the whole point of holding seven tokens apart
		// is that they call for seven different responses: reload, retry, fix
		// something else first, or stop trying.
		//
		// The token set is the blastRefuse* constants in
		// internal/api/handlers_blast_radius_restore.go. It is enumerated here
		// rather than derived, so a token added there without a string here
		// falls to the unknown branch instead of silently rendering nothing.
		//
		// UNKNOWN TOKENS DEGRADE LOUDLY, NEVER BLANK. A server newer than this
		// page (a mid-deploy reload, a cached script) can return a token this
		// map has never heard of. Returning '' would hide a refusal entirely --
		// the row would sit there refused with no explanation, which is worse
		// than the wrong-explanation defect this whole function exists to fix.
		// So an unrecognized token renders the unknown string with the RAW
		// token interpolated, giving the operator something to search for and a
		// support conversation something to quote. A missing/empty reason gets
		// '?' rather than an English literal, since every user-facing word here
		// comes from the translator.
		function blastRefusalText(reason) {
			var i18n = blastRestoreI18n();
			switch (reason) {
			case 'change_not_found':
				return i18n.refuseChangeNotFound || 'The change record is gone, so there is nothing left to restore.';
			case 'not_revertible':
				return i18n.refuseNotRevertible || 'This field keeps no change history.';
			case 'revert_of_revert':
				return i18n.refuseRevertOfRevert || 'This row is itself an undo, so undoing it would loop.';
			case 'no_longer_current':
				return i18n.refuseNoLongerCurrent || 'Something changed this field after this report loaded. Reload and look again.';
			case 'restore_failed':
				return i18n.refuseRestoreFailed || 'The write was attempted and failed. Trying again may work.';
			case 'old_value_invalid':
				return i18n.refuseOldValueInvalid || 'The previous value is one this field will not accept.';
			case 'name_collision':
				return i18n.refuseNameCollision || 'Another artist already holds that name. Rename or merge that artist first.';
			default:
				console.error('blast-radius restore returned an unrecognized refuse_reason', reason);
				return (i18n.refuseUnknown || 'Refused for a reason this page does not recognize ({reason}).')
					.replace('{reason}', reason || '?');
			}
		}

		// blastApplyRefusalReasons writes each item's refusal reason into its
		// own row, and clears the reason on any row the server did NOT refuse.
		//
		// Called for BOTH the preview and the commit. A preview that refuses a
		// row is exactly as informative as a commit that does, and it arrives
		// BEFORE the operator commits, which is the cheapest moment to learn a
		// row cannot be recovered.
		//
		// The clear arm matters as much as the set arm: an operator who fixes a
		// collision and re-previews must not be left reading the stale refusal
		// from the previous attempt next to a row that is now eligible.
		function blastApplyRefusalReasons(result) {
			var i18n = blastRestoreI18n();
			var label = i18n.refusedLabel || 'Refused:';
			(result.items || []).forEach(function(item) {
				var el = document.getElementById('blast-reason-' + item.change_id);
				// No element is not an error: the bulk path removes the rows it
				// restored before this runs on a later response, and a row on
				// another page of a server-paged table was never rendered.
				if (!el) return;
				if (item.restore_status !== 'refused') {
					el.textContent = '';
					el.classList.add('hidden');
					return;
				}
				el.textContent = label + ' ' + blastRefusalText(item.refuse_reason);
				el.classList.remove('hidden');
			});
		}

		// blastRestoreOutcomeToast reports a COMMITTED restore truthfully.
		//
		// commitBlastRestore re-reads the live value immediately before each
		// write, so the server can refuse at commit time an item the plan
		// listed as eligible (a scan, rule pass, or operator edit can land
		// between preview and commit). {restored:0, refused:N} is therefore a
		// designed-for response, not a hypothetical -- and reporting it with
		// the success toast put a GREEN banner reading "0 value(s) restored."
		// in front of an operator whose data was NOT recovered. On a recovery
		// surface that is the worst possible misreport.
		//
		// So the toast VARIANT is chosen from the counts, not assumed:
		//   restored === 0            -> error toast (nothing was recovered)
		//   restored > 0 && refused>0 -> warning toast naming BOTH numbers
		//   otherwise                 -> the success toast
		function blastRestoreOutcomeToast(result) {
			var i18n = blastRestoreI18n();
			var restored = result.restored || 0;
			var refused = result.refused || 0;
			var unchanged = result.unchanged || 0;
			if (restored === 0) {
				// Nothing landed. Say WHY where the server told us: refusals
				// first (the actionable case -- the rows are still damaged),
				// then the benign "already held that value" case.
				if (refused > 0) {
					showToast((i18n.restoreNone || 'Nothing was restored. {refused} value(s) were refused.').replace('{refused}', refused));
				} else if (unchanged > 0) {
					showToast((i18n.restoreUnchanged || 'Nothing was restored. {unchanged} value(s) already held the value being put back.').replace('{unchanged}', unchanged));
				} else {
					showToast(i18n.restoreNothing || 'Nothing was restored.');
				}
				return;
			}
			if (refused > 0) {
				// Partial success. Both numbers, in a warning variant: an
				// operator who reads only the color must not read this as a
				// clean recovery.
				showWarningToast((i18n.restorePartial || '{count} value(s) restored, {refused} refused.')
					.replace('{count}', restored).replace('{refused}', refused));
				return;
			}
			showSuccessToast((i18n.restoredCount || '{count} value(s) restored.').replace('{count}', restored));
		}

		// blastRestoreRow previews a single row, then commits on confirmation.
		function blastRestoreRow(id) {
			var i18n = blastRestoreI18n();
			blastRestoreRequest([id], false, function(plan) {
				// Reason first, dialog second. A plan that refuses this row
				// puts the WHY on the row before the operator decides, rather
				// than after they have approved something that cannot land.
				blastApplyRefusalReasons(plan);
				if (plan.eligible === 0) {
					showToast(blastRestorePlanSummary(plan));
					return;
				}
				window.showConfirmDialog(blastRestorePlanSummary(plan), null, function() {
					blastRestoreRequest([id], true, function(result) {
						blastRestoreOutcomeToast(result);
						// Before the removal below: a restored row is about to
						// leave the table anyway, and a REFUSED one stays and
						// needs its reason.
						blastApplyRefusalReasons(result);
						// Drop the row ONLY when the server says this item was
						// actually restored. Removing it unconditionally hid a
						// REFUSED restore: the row is still damaged and still
						// needs the operator, but it vanished from the table
						// until reload. Same guard the bulk path uses.
						// Match on change_id rather than position. items[0]
						// assumed the server returns exactly one item, in
						// request order, for a single-id request; keying on the
						// id makes no such assumption and reads identically to
						// the bulk path below.
						(result.items || []).forEach(function(item) {
							if (item.change_id !== id || item.restore_status !== 'restored') return;
							var row = document.getElementById('blast-row-' + id);
							if (row) row.remove();
						});
						// The removed row may have been ticked, so the bar's count is now
						// stale. Re-derive it from the DOM rather than leave a number that
						// overstates what a bulk restore would touch.
						blastUpdateBulkBar();
					});
				}, { title: i18n.confirmTitle || 'Restore value?', acceptText: i18n.confirmAccept || 'Restore' });
			});
		}

		// ---- Bulk selection -------------------------------------------------
		//
		// These handlers are PANE-LOCAL on purpose. The compliance pane has its
		// own toggleSelectAll/updateBulkBar/clearBulkSelection in
		// repComplianceScript, and the pane dispatch is an else-if chain, so at
		// most one of the two scripts is ever on the page. Sharing one
		// implementation would mean a second render surface to keep correct and
		// two panes contending for the same document-wide selectors. The names
		// here (.blast-select, #blast-select-all, #blast-bulk-bar) are disjoint
		// from the compliance ones so neither pane can reach the other's rows.

		// blastSelectedIDs returns the change ids of the ticked rows in DOM
		// order, so a preview lists them the way the table does.
		function blastSelectedIDs() {
			var ids = [];
			document.querySelectorAll('.blast-select:checked').forEach(function(cb) { ids.push(cb.value); });
			return ids;
		}

		// blastToggleSelectAll ticks/unticks every row CURRENTLY RENDERED. The
		// pane is server-paged, so this deliberately cannot reach rows on other
		// pages; see the header comment on the control.
		function blastToggleSelectAll(master) {
			document.querySelectorAll('.blast-select').forEach(function(cb) { cb.checked = master.checked; });
			blastUpdateBulkBar();
		}

		// blastUpdateBulkBar reveals the bar once at least one row is selected
		// and reports HOW MANY, so the operator sees the size of the write they
		// are about to preview.
		//
		// Ordering matters in BOTH directions.
		//
		// On REVEAL: #blast-bulk-count is an aria-live region, and a mutation
		// made while it is display:none is not announced. The bar is unhidden
		// BEFORE the count text is written, so the reveal produces an
		// announcement rather than a silent appearance.
		//
		// On HIDE: focus is moved out of the bar BEFORE it is hidden. Hiding
		// the element that currently holds focus resets focus to <body>, which
		// strands a keyboard user at the top of the document right after a
		// destructive operation. See the n === 0 branch.
		function blastUpdateBulkBar() {
			var bar = document.getElementById('blast-bulk-bar');
			var count = document.getElementById('blast-bulk-count');
			if (!bar) {
				// Loud, not silent: a missing bar means the affordance is inert,
				// which is the exact defect that got the earlier cut removed.
				console.error('blast-radius: #blast-bulk-bar is missing, bulk selection cannot be shown');
				return;
			}
			var boxes = document.querySelectorAll('.blast-select');
			var n = document.querySelectorAll('.blast-select:checked').length;
			var master = document.getElementById('blast-select-all');
			if (master) {
				master.checked = boxes.length > 0 && n === boxes.length;
				// A partial selection is neither checked nor unchecked, and
				// saying so is what stops "select all" reading as already done.
				master.indeterminate = n > 0 && n < boxes.length;
			}
			if (n === 0) {
				// Move focus OUT before hiding. .hidden is display:none, and a
				// browser blurs a focused element that becomes display:none --
				// focus resets to <body>. Both paths that reach here on a
				// keyboard (Cancel, and blastClearSelection after a commit)
				// have focus INSIDE this bar at that moment: the shared modal's
				// hideModal restores focus to the opener, which is the "Restore
				// Selected" button in this bar, and only then does the callback
				// hide it. Without this, a keyboard user who just committed a
				// destructive operation is dumped at the top of the document.
				// #blast-select-all is the nearest stable control that owns the
				// selection this bar was reporting on.
				if (bar.contains(document.activeElement)) {
					var refocus = document.getElementById('blast-select-all');
					if (refocus) {
						refocus.focus();
					} else {
						// Loud, not silent: with no select-all to catch it,
						// focus is about to fall to <body> and we cannot stop
						// it. Say so rather than leave a silent a11y defect.
						console.error('blast-radius: #blast-select-all is missing, focus will be lost when the bulk bar hides');
					}
				}
				bar.classList.add('hidden');
				if (count) count.textContent = '';
				return;
			}
			bar.classList.remove('hidden');
			if (count) {
				count.textContent = n === 1
					? (count.dataset.oneText || '1 selected')
					: (count.dataset.manyTemplate || '{count} selected').replace('{count}', String(n));
			}
		}

		// blastClearSelection unticks everything and hides the bar. Used by the
		// bar's own Cancel and after a committed restore.
		function blastClearSelection() {
			document.querySelectorAll('.blast-select').forEach(function(cb) { cb.checked = false; });
			var master = document.getElementById('blast-select-all');
			if (master) {
				master.checked = false;
				master.indeterminate = false;
			}
			blastUpdateBulkBar();
		}

		// THE BULK BAR IS OUTSIDE THE SWAP TARGET, SO THE SWAP MUST RESET IT.
		//
		// #blast-bulk-bar is deliberately rendered AFTER #blast-radius-pane
		// closes, and that position is load-bearing for accessibility: the bar
		// sits in normal document order after the table, so it is reachable and
		// escapable by Tab rather than being a focus trap, and its live region
		// is scoped to #blast-bulk-count alone. Moving it inside the container
		// to let the swap clear it would put those properties at risk for a
		// problem that is cheaper to fix here.
		//
		// Being outside means the filter reload replaces the TABLE -- removing
		// every checked .blast-select with it -- while the bar and its count
		// survive untouched. Measured before this handler: tick three rows,
		// apply a filter, and the bar still reads "3 selected" over a table
		// whose rows are all unticked. Pressing Restore Selected then calls
		// blastSelectedIDs(), which queries .blast-select:checked in the FRESH
		// DOM, gets an empty list, and the action returns having done nothing
		// and said nothing.
		//
		// A destructive-recovery control reporting a selection that does not
		// exist is the same class of defect as the stale caveat band, one
		// control over: the pane states something about the operator's data
		// that is not true, on the surface whose whole job is putting destroyed
		// values back.
		//
		// blastUpdateBulkBar is the whole fix rather than a bespoke reset: it
		// recounts .blast-select:checked in the post-swap DOM, finds zero, and
		// takes its own n === 0 branch -- which hides the bar, clears the count,
		// resyncs the select-all checkbox and its indeterminate state, and moves
		// focus out first if it is inside the bar. Reusing it means the reset
		// cannot drift from the hide path the rest of the pane already uses.
		// Recorded BEFORE the swap, because afterSwap is too late to ask: by
		// then the old node is gone and document.activeElement already reads
		// <body>, which is indistinguishable from a page nobody had focused.
		var blastFocusWasInPane = false;

		document.body.addEventListener('htmx:beforeSwap', function(evt) {
			if (!evt.detail || !evt.detail.target || evt.detail.target.id !== 'blast-radius-pane') return;
			var pane = document.getElementById('blast-radius-pane');
			blastFocusWasInPane = !!(pane && document.activeElement && pane.contains(document.activeElement));
		});

		document.body.addEventListener('htmx:afterSwap', function(evt) {
			if (!evt.detail || !evt.detail.target || evt.detail.target.id !== 'blast-radius-pane') return;

			// Bulk bar FIRST. Its n === 0 branch may deliberately move focus to
			// #blast-select-all when focus is inside the bar, and the
			// restore below must not override that decision -- hence the
			// "focus is still on <body>" condition, which is false once the bar
			// has placed it somewhere.
			blastUpdateBulkBar();

			// RESTORE FOCUS THE SWAP TOOK.
			//
			// The flyout's Apply starts this reload and then closes the panel,
			// and closing returns focus to #blast-radius-filter-trigger -- which
			// lives INSIDE #blast-radius-pane, so the outerHTML swap then
			// removes the very node holding focus. A browser blurs a removed
			// element and focus resets to <body>, which drops a keyboard
			// operator at the top of the document immediately after acting, with
			// the whole page to Tab back through. Same shape as the bulk bar's
			// hide-with-focus-inside defect, one control over.
			//
			// Both conditions are required. blastFocusWasInPane says the swap is
			// what took focus rather than the page never having had any, and the
			// activeElement check says nothing has since claimed it.
			var lost = !document.activeElement || document.activeElement === document.body;
			if (blastFocusWasInPane && lost) {
				var trigger = document.getElementById('blast-radius-filter-trigger');
				if (trigger) {
					trigger.focus();
				} else {
					// Loud, not silent: focus is on <body> and we cannot place
					// it. Saying so beats leaving an a11y defect to be noticed
					// by the person it strands.
					console.error('blast-radius: #blast-radius-filter-trigger is missing after a swap, so focus stays lost at the top of the document');
				}
			}
			blastFocusWasInPane = false;
		});

		// blastRestoreSelected is the bulk mirror of blastRestoreRow: DRY RUN
		// first (commit:false writes nothing), show the plan, and commit only on
		// an explicit second affirmative action in the confirm dialog. The first
		// click can never write.
		function blastRestoreSelected() {
			var ids = blastSelectedIDs();
			if (!ids.length) return;
			var i18n = blastRestoreI18n();
			blastRestoreRequest(ids, false, function(plan) {
				// Reason first. A bulk plan can refuse several rows for several
				// DIFFERENT reasons at once, which is precisely what the
				// summary line cannot say and the per-row labels can.
				blastApplyRefusalReasons(plan);
				// A plan with nothing eligible is reported and stops here rather
				// than opening a dialog whose only honest action is Cancel.
				if (plan.eligible === 0) {
					showToast(blastRestorePlanSummary(plan));
					return;
				}
				window.showConfirmDialog(blastRestorePlanSummary(plan), null, function() {
					blastRestoreRequest(ids, true, function(result) {
						blastRestoreOutcomeToast(result);
						blastApplyRefusalReasons(result);
						// Drop ONLY the rows the server reports as actually
						// restored. Removing every requested row would hide the
						// refusals -- rows still damaged and still needing the
						// operator's attention.
						(result.items || []).forEach(function(item) {
							if (item.restore_status !== 'restored') return;
							var row = document.getElementById('blast-row-' + item.change_id);
							if (row) row.remove();
						});
						blastClearSelection();
					});
				}, {
					title: i18n.confirmTitleBulk || 'Restore selected values?',
					acceptText: i18n.confirmAccept || 'Restore'
				});
			});
		}
	</script>
}

// NFOMBIDPaneData is the view model for the rule-written MusicBrainz ID pane
// (issue #2809, reopened because the API + CSV alone did not meet the
// "surfaced somewhere an operator can act on it" bar). Assembled by
// loadReportsNFOMBIDData, which calls the same historyService methods the
// JSON report and CSV export already use, so the three surfaces cannot
// disagree about which artists a rule-picked MusicBrainz ID touched.
type NFOMBIDPaneData struct {
	Rows       []artist.NFOMBIDWriteRow
	Counts     artist.NFOMBIDCounts
	Pagination components.PaginationData
	// ArtistID mirrors the active filter so the pane can reflect current
	// narrowing back to the operator, matching BlastRadiusData's ArtistID.
	ArtistID string
	BasePath string
}

// repPaneNFOHasMBID renders the right pane for the rule-written MusicBrainz ID
// report (issue #2809): which artists the automatic NFO rule fix assigned a
// MusicBrainz ID to, so an operator can review and correct a bad guess.
//
// Modeled on repPaneBlastRadius, but simpler: this report is read-only end to
// end (no restore, no bulk selection, no JS write path) because deciding
// whether a guessed ID is correct requires the operator to look the artist up
// on MusicBrainz, which is out of scope here (issue #2810). Every row's action
// is "go look at this artist", via a plain link to its detail page -- there is
// nothing this pane itself can commit.
//
// THE CAVEAT BAND IS THE SUBSTANCE, NOT DECORATION. This report exists
// because a rule adopted best-guess matches and some were wrong, so the ways
// the report can mislead matter more than the ways it can be slow. It is
// rendered in an always-visible <div role="note"> immediately under the pane
// header -- never a collapsed <details>, never a tooltip -- because a count
// presented as complete IS the defect issue #2809 was filed about. All four
// caveats the API/CSV already ship are repeated here verbatim (via the
// artist.NFOMBIDCaveat* constants, shared with handlers_nfo_mbid.go) so the
// three surfaces cannot drift into saying different things about the same
// limits:
//
//  1. SCOPE: only the automatic NFO rule fix is enumerable here.
//  2. FLOOR: every count is a minimum, never a census.
//  3. NO PRIOR VALUE: this rule only ever filled a blank, never overwrote an
//     ID an operator had set -- so there is deliberately no "previous value"
//     column (see the doc comment on NFOMBIDWriteRow for why one would always
//     read empty and invite the wrong conclusion).
//  4. NOT CONFIRMED: an artist absent from this list has not been vetted by
//     anyone. Nothing today records operator confirmation of an ID, so
//     absence is UNKNOWN, never evidence of a clean bill of health.
templ repPaneNFOHasMBID(data NFOMBIDPaneData) {
	<div class="sw-rep-pane-header">
		<div class="sw-rep-pane-title-block">
			<p class="sw-rep-pane-title">{ t(ctx, "reports.nfo_has_mbid.label") }</p>
			<p class="sw-rep-pane-desc">{ t(ctx, "reports.nfo_has_mbid.desc") }</p>
		</div>
		<div class="sw-rep-pane-actions">
			<a
				id="nfo-mbid-export-link"
				href={ templ.SafeURL(data.BasePath + "/api/v1/reports/nfo-has-mbid/export" + nfoMBIDExportQuery(data)) }
				class="sw-rep-export-btn"
			>
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
				</svg>
				{ t(ctx, "common.export_csv") }
			</a>
		</div>
	</div>
	<!-- Caveat band. Always rendered, never conditional on there being rows,
	     see the doc comment above for why. Every string is a shared constant
	     also used by the JSON response and the CSV notes, so the three
	     surfaces cannot drift apart. -->
	<div id="nfo-mbid-caveats" class="sw-rep-blast-caveat" role="note">
		<p class="sw-rep-blast-caveat-line">
			{ tf(ctx, "reports.nfo_has_mbid.summary", data.Counts.Writes, data.Counts.Artists) }
		</p>
		<p class="sw-rep-blast-caveat-line">{ artist.NFOMBIDCaveatScope }</p>
		<p class="sw-rep-blast-caveat-line">{ artist.NFOMBIDCaveatFloor }</p>
		<p class="sw-rep-blast-caveat-line">{ artist.NFOMBIDCaveatRetention }</p>
		<p class="sw-rep-blast-caveat-line">{ artist.NFOMBIDCaveatNoPriorValue }</p>
		<p class="sw-rep-blast-caveat-line">{ artist.NFOMBIDCaveatNotConfirmed }</p>
		<p class="sw-rep-blast-caveat-line">{ artist.NFOMBIDCaveatMessageWording }</p>
	</div>
	<div class="overflow-x-auto" id="nfo-mbid-results">
		<table id="nfo-mbid-tbl" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
			<thead class="bg-gray-50 dark:bg-gray-800">
				<tr>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.column_artist") }</th>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.nfo_has_mbid.column_current_mbid") }</th>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.nfo_has_mbid.column_note") }</th>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.blast_radius.column_when") }</th>
					<th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">{ t(ctx, "reports.nfo_has_mbid.column_review") }</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
				if len(data.Rows) == 0 {
					<tr>
						<td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
							{ t(ctx, "reports.nfo_has_mbid.empty") }
						</td>
					</tr>
				}
				for _, row := range data.Rows {
					@nfoMBIDRow(data.BasePath, row)
				}
			</tbody>
		</table>
	</div>
	@nfoMBIDPagination(data)
}

// nfoMBIDCurrentIDLabel renders the current-MusicBrainz-ID cell text. Mirrors
// nfoMBIDCurrentIDCell in handlers_nfo_mbid.go (that one is CSV-scoped and
// unexported from this package, so the templ side carries its own copy) --
// a missing ID is spelled out rather than left blank, because a blank cell in
// a table reads as "nothing to see" and this is the column an operator acts
// on.
func nfoMBIDCurrentIDLabel(ctx context.Context, row artist.NFOMBIDWriteRow) string {
	if !row.HasCurrentMusicBrainzID {
		return t(ctx, "reports.nfo_has_mbid.none_recorded")
	}
	return row.CurrentMusicBrainzID
}

// nfoMBIDRow renders one MusicBrainz ID the nfo_has_mbid rule fixer wrote:
// artist, the ID it carries now, the recorded audit note, when, and a link to
// the artist's own detail page -- the review action, since this report cannot
// itself validate or revert an ID (issue #2810).
templ nfoMBIDRow(basePath string, row artist.NFOMBIDWriteRow) {
	<tr id={ "nfo-mbid-row-" + row.ID } class="hover:bg-gray-50 dark:hover:bg-gray-800">
		<td class="px-4 py-3 text-sm">{ row.ArtistName }</td>
		<td class="px-4 py-3 text-sm font-mono">
			if !row.HasCurrentMusicBrainzID {
				<span class="italic text-gray-500 dark:text-gray-400">{ nfoMBIDCurrentIDLabel(ctx, row) }</span>
			} else {
				{ nfoMBIDCurrentIDLabel(ctx, row) }
			}
		</td>
		<td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400">{ historyTruncate(row.Message, 100) }</td>
		<td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">
			<time datetime={ row.CreatedAt.Format(time.RFC3339) } title={ row.CreatedAt.Format("2006-01-02 15:04:05 UTC") }>
				{ historyTimeAgo(ctx, row.CreatedAt) }
			</time>
		</td>
		<td class="px-4 py-3 text-right">
			<a
				href={ templ.SafeURL(basePath + "/artists/" + row.ArtistID) }
				class="text-xs px-2 py-1 rounded border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
			>
				{ t(ctx, "reports.nfo_has_mbid.review") }
			</a>
		</td>
	</tr>
}

// nfoMBIDExportQuery carries the active ArtistID filter onto the CSV export
// link, so the download matches whatever the pane is currently narrowed to --
// the same reasoning blastRadiusPageURL documents for its own filters.
func nfoMBIDExportQuery(data NFOMBIDPaneData) string {
	if data.ArtistID == "" {
		return ""
	}
	q := url.Values{}
	q.Set("artist_id", data.ArtistID)
	return "?" + q.Encode()
}

// nfoMBIDPageURL builds a pager link carrying the page size and the active
// ArtistID filter forward, mirroring blastRadiusPageURL's reasoning: an
// omitted page_size falls back to the stored preference, which is how rows go
// missing between pages of different sizes, and dropping the filter would
// silently widen page 2 to the unfiltered report.
func nfoMBIDPageURL(data NFOMBIDPaneData, page int) string {
	q := url.Values{}
	if data.ArtistID != "" {
		q.Set("artist_id", data.ArtistID)
	}
	q.Set("page_size", strconv.Itoa(data.Pagination.PageSize))
	q.Set("page", strconv.Itoa(page))
	return data.BasePath + "/reports/nfo-has-mbid?" + q.Encode()
}

// nfoMBIDPagination renders a plain (non-HTMX) prev/next pager, matching
// blastRadiusPagination: /reports/nfo-has-mbid has no fragment endpoint to
// swap against, so a full-page navigation link is correct here too.
templ nfoMBIDPagination(data NFOMBIDPaneData) {
	if data.Pagination.TotalPages > 1 {
		<nav class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 px-4 py-3" aria-label={ t(ctx, "reports.nfo_has_mbid.pager_label") }>
			<p class="text-sm text-gray-700 dark:text-gray-300">
				{ tf(ctx, "reports.nfo_has_mbid.page_of", data.Pagination.CurrentPage, data.Pagination.TotalPages) }
			</p>
			<div class="flex gap-2">
				if data.Pagination.CurrentPage > 1 {
					<a
						href={ templ.SafeURL(nfoMBIDPageURL(data, data.Pagination.CurrentPage-1)) }
						class="relative inline-flex items-center rounded-md bg-white dark:bg-gray-800 px-3 py-2 text-sm font-semibold text-gray-900 dark:text-gray-100 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700"
					>{ t(ctx, "common.previous") }</a>
				}
				if data.Pagination.CurrentPage < data.Pagination.TotalPages {
					<a
						href={ templ.SafeURL(nfoMBIDPageURL(data, data.Pagination.CurrentPage+1)) }
						class="relative inline-flex items-center rounded-md bg-white dark:bg-gray-800 px-3 py-2 text-sm font-semibold text-gray-900 dark:text-gray-100 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700"
					>{ t(ctx, "common.next") }</a>
				}
			</div>
		</nav>
	}
}

// repComplianceScript renders the JS for the compliance workspace pane so
// these functions are available when ComplianceTable is embedded in the
// reports workspace. The run-rules flow lives in the companion
// repRunRulesScript partial.
templ repComplianceScript() {
	<script>
		// Tab switching: toggle aria-selected + hidden on the tab panels.
		function swRepTabSwitch(name) {
			document.getElementById('sw-rep-tabbar').querySelectorAll('[role="tab"]').forEach(function(btn) {
				btn.setAttribute('aria-selected', btn.id === 'sw-rep-tab-btn-' + name ? 'true' : 'false');
				btn.classList.toggle('is-active', btn.id === 'sw-rep-tab-btn-' + name);
			});
			// Move the one #compliance-results shell into the active tab so a single
			// #compliance-tbl / #select-all ever exists (#2079). The shell is the HTMX
			// swap target, so outerHTML refreshes replace it in place wherever it
			// currently lives -- keeping both tabs in sync with no duplicate render.
			var results = document.getElementById('compliance-results');
			if (results) {
				var target = name === 'matrix'
					? document.getElementById('sw-rep-matrix-mount')
					: document.getElementById('sw-rep-tab-results');
				if (target && results.parentElement !== target) {
					target.appendChild(results);
				}
			}
			['results', 'matrix'].forEach(function(tab) {
				var panel = document.getElementById('sw-rep-tab-' + tab);
				if (panel) panel.classList.toggle('hidden', tab !== name);
			});
		}

		// Column sort: swap sort/order hidden inputs and re-issue the compliance
		// search request. The search input carries the request contract
		// (hx-get/target/swap/include), so we fire its dedicated "sortchanged"
		// trigger rather than a synthetic "keyup" -- keyup is gated by the
		// input's "changed" modifier, which suppresses the request when the
		// search term itself has not changed (the reason header sorting never
		// actually fired). "sortchanged" has no such guard, so every header
		// click re-sorts (#2304).
		function sortBy(col) {
			var sortInput = document.getElementById('compliance-sort');
			var orderInput = document.getElementById('compliance-order');
			if (!sortInput || !orderInput) return;
			var curSort = sortInput.value;
			var curOrder = orderInput.value;
			// Cycle the clicked column: asc -> desc -> off. "off" clears the sort
			// param so the server falls back to the default ordering (name asc).
			if (curSort === col && curOrder === 'asc') {
				orderInput.value = 'desc';
			} else if (curSort === col && curOrder === 'desc') {
				sortInput.value = '';
				orderInput.value = 'asc';
			} else {
				sortInput.value = col;
				orderInput.value = 'asc';
			}
			var searchInput = document.querySelector('[name="search"]');
			if (searchInput) htmx.trigger(searchInput, 'sortchanged');
		}

		// Bulk selection helpers.
		function toggleSelectAll(checkbox) {
			document.querySelectorAll('.bulk-select').forEach(function(cb) { cb.checked = checkbox.checked; });
			updateBulkBar();
		}

		function updateBulkBar() {
			var selected = document.querySelectorAll('.bulk-select:checked');
			var bar = document.getElementById('bulk-action-bar');
			var count = document.getElementById('bulk-count');
			if (!bar) return;
			if (selected.length > 0) {
				bar.classList.remove('hidden');
				if (count) {
					count.textContent = selected.length === 1
						? (count.dataset.oneText || '1 selected')
						: (count.dataset.manyTemplate || '{count} selected').replace('{count}', String(selected.length));
				}
			} else {
				bar.classList.add('hidden');
				if (count) count.textContent = count.dataset.zeroText || '';
			}
		}

		function clearBulkSelection() {
			document.querySelectorAll('.bulk-select').forEach(function(cb) { cb.checked = false; });
			var sa = document.getElementById('select-all');
			if (sa) sa.checked = false;
			updateBulkBar();
		}

		function bulkAction(action) {
			var ids = [];
			document.querySelectorAll('.bulk-select:checked').forEach(function(cb) { ids.push(cb.value); });
			if (!ids.length) return;
			var bp = (function() { var el = document.querySelector('meta[name="htmx-base-path"]'); return el ? el.content : ''; })();
			var csrf = document.cookie.replace(/(?:(?:^|.*;\s*)csrf_token\s*=\s*([^;]*).*$)|^.*$/, '$1');
			fetch(bp + '/api/v1/bulk/' + action, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
				body: JSON.stringify({ mode: 'prompt_no_match', artist_ids: ids })
			}).then(function(resp) {
				if (resp.ok) clearBulkSelection();
			}).catch(function() {});
		}

		// Re-sync bulk bar after HTMX swaps reload the table rows.
		document.body.addEventListener('htmx:afterSettle', function() { updateBulkBar(); });

		// Filter flyout applies filters: dispatch sw:filter-applied on #compliance-results.
		document.body.addEventListener('sw:filter-applied', function(evt) {
			if (!evt.target || evt.target.id !== 'compliance-results') return;
			htmx.ajax('GET', '/reports/compliance' + window.location.search, { target: '#compliance-results', swap: 'outerHTML' });
		});

		// Hydrate filter flyout from URL on first paint.
		document.addEventListener('DOMContentLoaded', function() {
			if (window.swFilterFlyout) swFilterFlyout.initFromURL('compliance-filter-flyout');
		});

		// rewriteComplianceExport copies the current search params onto the
		// export link so the CSV download reflects the active filters.
		function rewriteComplianceExport(link) {
			var base = link.dataset.exportBase || link.href;
			var params = new URLSearchParams(window.location.search);
			// Keep only canonical compliance filter params.
			var keep = ['search', 'status', 'filter', 'library_id', 'sort', 'order', 'health_min', 'health_max'];
			var out = new URLSearchParams();
			keep.forEach(function(k) {
				var field = document.querySelector('[name="' + k + '"]');
				var value = field ? field.value : params.get(k);
				if (value !== null && value !== '') out.set(k, value);
			});
			var qs = out.toString();
			link.href = qs ? base + '?' + qs : base;
		}
	</script>
}

// repRailFilterScript renders the JS for the rail filter input.
// Matching is case-insensitive against data-rep-label on each list item.
templ repRailFilterScript() {
	<script>
		function swRepRailFilter(query) {
			var q = query.toLowerCase();
			document.querySelectorAll('#sw-rep-list .sw-rep-list-item').forEach(function(li) {
				var label = (li.dataset.repLabel || '').toLowerCase();
				li.hidden = q.length > 0 && !label.includes(q);
			});
		}
	</script>
}

// repRailDrawerScript renders the controller for the mobile (<=768px) rail
// drawer. The rail (<nav id="sw-rep-rail">) doubles as a slide-over at narrow
// widths; this toggles the --open class + scrim, closes on Esc/scrim tap, and
// moves focus into the rail on open / back to the toggle on close. On desktop
// the rail is an in-grid column and the toggle button is display:none, so none
// of this fires. Focus removal while closed is handled by CSS visibility:hidden
// (viewport-aware via the media query), so no inert/aria-hidden juggling is
// needed on the dual-purpose element.
templ repRailDrawerScript() {
	<script>
		window.swReportsRailDrawer = (function() {
			var RAIL_ID = 'sw-rep-rail';
			var SCRIM_ID = 'sw-rep-rail-scrim';
			// Focusable selector for the focus-trap (mirrors prefs-drawer.js).
			var FOCUSABLE = [
				'a[href]',
				'button:not([disabled])',
				'input:not([disabled])',
				'select:not([disabled])',
				'textarea:not([disabled])',
				'[tabindex]:not([tabindex="-1"])'
			].join(',');
			var _opener = null;

			function rail()  { return document.getElementById(RAIL_ID); }
			function scrim() { return document.getElementById(SCRIM_ID); }
			function isOpen() {
				var r = rail();
				return r ? r.classList.contains('sw-rep-rail--open') : false;
			}
			function triggers() {
				return Array.prototype.slice.call(document.querySelectorAll('.sw-rep-rail-toggle'));
			}

			function open() {
				var r = rail();
				if (!r || isOpen()) return;
				_opener = document.activeElement;
				r.classList.add('sw-rep-rail--open');
				var s = scrim();
				if (s) s.classList.add('sw-rep-rail-scrim--visible');
				triggers().forEach(function(t) { t.setAttribute('aria-expanded', 'true'); });
				// Move focus into the drawer (the rail search input is the first
				// focusable child) so the trap has a real anchor.
				var focusable = r.querySelectorAll(FOCUSABLE);
				if (focusable.length) focusable[0].focus();
				// Scope the trap to the drawer element (prefs-drawer.js pattern): it
				// only fires while focus is inside, and is removed symmetrically on
				// close so it never persists while the drawer is shut.
				r.addEventListener('keydown', onKeydown);
			}

			function close() {
				var r = rail();
				if (!r || !isOpen()) return;
				r.classList.remove('sw-rep-rail--open');
				var s = scrim();
				if (s) s.classList.remove('sw-rep-rail-scrim--visible');
				triggers().forEach(function(t) { t.setAttribute('aria-expanded', 'false'); });
				r.removeEventListener('keydown', onKeydown);
				if (_opener && typeof _opener.focus === 'function') { _opener.focus(); }
				_opener = null;
			}

			function toggle() { if (isOpen()) { close(); } else { open(); } }

			// Esc closes; Tab / Shift+Tab wrap focus within the open drawer so it
			// cannot walk out into the pane controls obscured behind the scrim.
			function onKeydown(ev) {
				if (ev.key === 'Escape') { ev.preventDefault(); close(); return; }
				if (ev.key !== 'Tab') return;
				var r = rail();
				if (!r) return;
				var focusable = Array.prototype.slice.call(r.querySelectorAll(FOCUSABLE));
				if (!focusable.length) { ev.preventDefault(); return; }
				var first = focusable[0];
				var last = focusable[focusable.length - 1];
				if (ev.shiftKey) {
					if (document.activeElement === first || !r.contains(document.activeElement)) {
						ev.preventDefault();
						last.focus();
					}
				} else {
					if (document.activeElement === last || !r.contains(document.activeElement)) {
						ev.preventDefault();
						first.focus();
					}
				}
			}

			return { open: open, close: close, toggle: toggle };
		})();
	</script>
}

// repRunRulesScript renders the "Run Rules" / "Re-evaluate All" button logic
// with a confirmation modal that shows artist count and estimated duration
// before starting evaluation. Ported verbatim from the retired v1 compliance
// page (#698; restored for the promoted workspace in #1757 PR-4). Shared
// helpers (showConfirmDialog, toasts, pollAsyncStatus) all ship with the
// canonical Layout chrome.
templ repRunRulesScript() {
	<script>
		// confirmAndRunRules fetches the artist count, then shows a confirmation
		// modal with the estimated duration before starting rule evaluation.
		// scope is "incremental" (default Run Rules, #698) or "all"
		// (Re-evaluate All admin escape hatch).
		function confirmAndRunRules(scope) {
			scope = (scope === 'all') ? 'all' : 'incremental';
			var bp = (function() {
				var el = document.querySelector('meta[name="htmx-base-path"]');
				return el ? el.content : '';
			})();

			// Fetch artist count from the health endpoint to build the estimate.
			fetch(bp + '/api/v1/reports/health')
				.then(function(res) {
					if (!res.ok) {
						// If we cannot determine the count, proceed without estimate.
						showRunRulesConfirm(bp, 0, scope);
						return;
					}
					return res.json();
				})
				.then(function(data) {
					if (!data) return;
					var count = (data && data.total_artists) ? data.total_artists : 0;
					showRunRulesConfirm(bp, count, scope);
				})
				.catch(function() {
					// Preserve the requested scope on estimate failure; a
					// dropped scope would silently downgrade Re-evaluate
					// All to incremental on any transient /reports/health
					// hiccup.
					showRunRulesConfirm(bp, 0, scope);
				});
		}

		function showRunRulesConfirm(bp, artistCount, scope) {
			var btn = document.getElementById('run-rules-btn');
			var ds = btn ? btn.dataset : {};
			var isAll = scope === 'all';
			// scope=all uses the stronger warning copy pulled from the
			// confirm-all-* data attributes. scope=incremental keeps the
			// familiar Run Rules copy.
			var bodyTemplate = isAll
				? (ds.confirmAllBody || 'Force a full re-evaluation of every eligible artist.')
				: (ds.confirmBody || 'This will evaluate rules for all artists.<br><br>The evaluation runs in the background -- you can continue using Stillwater while it runs.');
			var estimateTemplate = isAll
				? (ds.confirmAllBodyEstimate || bodyTemplate)
				: (ds.confirmBodyEstimate || 'This will evaluate rules for <strong>{artists}</strong> artists and may take approximately <strong>{duration}</strong>.<br><br>The evaluation runs in the background -- you can continue using Stillwater while it runs.');
			var message;
			if (artistCount > 0) {
				var minutes = Math.ceil(artistCount * 0.05 / 60);
				if (minutes < 1) minutes = 1;
				var minuteLabel = (minutes === 1)
					? (ds.confirmMinuteOne || '{count} minute').replace('{count}', minutes)
					: (ds.confirmMinuteOther || '{count} minutes').replace('{count}', minutes);
				message = estimateTemplate
					.replace('{artists}', artistCount)
					.replace('{duration}', minuteLabel);
			} else {
				message = bodyTemplate;
			}

			// Pass customizations via opts so the modal resets them in hideModal.
			// No pre-mutation of the shared modal DOM is needed.
			window.showConfirmDialog(message, 'run_rules', function() {
				startRuleRun(bp, scope);
			}, {
				html: true,
				title: isAll ? (ds.confirmAllTitle || 'Re-evaluate all artists?') : (ds.confirmTitle || 'Run Rules'),
				acceptText: isAll ? (ds.confirmAllAccept || 'Re-evaluate All') : (ds.confirmAccept || 'Start'),
				// The modal's default accept is the danger-red treatment; Run
				// Rules is non-destructive, so restyle the accept with the
				// pane's accent-emphasis motif classes (no solid-blue fill --
				// #1757 PR-4 sweep). The focus ring matches the canonical
				// artist-detail buttons.
				acceptClass: 'sw-rep-run-btn sw-rep-run-btn--primary focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2'
			});
		}

		// lastRunStickyToast holds the sticky summary toast from the most
		// recent Run Rules completion (#698). We dismiss it at the start
		// of the next run so two summaries never sit in the toast stack at
		// the same time.
		var lastRunStickyToast = null;

		function startRuleRun(bp, scope) {
			var btn = document.getElementById('run-rules-btn');
			var allBtn = document.getElementById('run-rules-all-btn');
			var spinner = document.getElementById('run-rules-spinner');
			var label = document.getElementById('run-rules-label');

			if (btn) btn.disabled = true;
			if (allBtn) allBtn.disabled = true;
			if (spinner) spinner.classList.remove('hidden');
			if (label) label.textContent = (btn && btn.dataset.labelRunning) || 'Running...';
			// Dismiss any prior sticky summary so the next run owns the
			// toast stack; it will be replaced on completion. Guard the
			// dismiss call because a throwing showStickyToast on the
			// previous run may have left lastRunStickyToast unassigned
			// or without a dismiss handle.
			if (lastRunStickyToast && typeof lastRunStickyToast.dismiss === 'function') {
				try { lastRunStickyToast.dismiss(); } catch (e) { /* ignore */ }
			}
			lastRunStickyToast = null;

			var csrfVal = (function() {
				var m = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/);
				return m ? m[1] : '';
			})();

			var url = bp + '/api/v1/rules/run-all' + (scope === 'all' ? '?scope=all' : '');
			fetch(url, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'X-CSRF-Token': csrfVal
				}
			}).then(function(r) {
				if (r.status === 202) {
					showSuccessToast((btn && btn.dataset.toastStarted) || 'Rule evaluation started...');
					pollRuleStatus(bp);
				} else if (r.status === 409) {
					showToast((btn && btn.dataset.toastAlreadyRunning) || 'Rules already running');
					pollRuleStatus(bp);
				} else {
					return r.json().then(function(data) {
						showToast(data.error || (btn && btn.dataset.toastFailedStart) || 'Failed to start rules');
						resetRuleButton();
					});
				}
			}).catch(function() {
				showToast((btn && btn.dataset.toastFailedStartEvaluation) || 'Failed to start rule evaluation');
				resetRuleButton();
			});
		}

		function pollRuleStatus(bp) {
			var btn = document.getElementById('run-rules-btn');
			pollAsyncStatus(bp + '/api/v1/rules/run-all/status', {
				onData: function(data) {
					if (data.status === 'completed') {
						// Combine the incremental summary (#698) with the
						// violation outcome into a single persistent toast
						// so the user has one dismissable record of the run,
						// not a transient toast plus a caption card.
						var summary = buildRunSummary(data);
						var outcome;
						if (data.violations_found === 0) {
							outcome = (btn && btn.dataset.msgNoViolations) || 'No violations found';
						} else if (data.violations_remaining === 0 && data.violations_auto_fixed > 0) {
							outcome = ((btn && btn.dataset.msgAllAutoFixed) || 'Found {found} violations, all auto-fixed').replace('{found}', data.violations_found);
						} else if (data.violations_auto_fixed > 0) {
							outcome = ((btn && btn.dataset.msgViolationsFoundAutoFixed) || 'Found {found} violations ({autoFixed} auto-fixed, {remaining} remaining)')
								.replace('{found}', data.violations_found).replace('{autoFixed}', data.violations_auto_fixed).replace('{remaining}', data.violations_remaining);
						} else {
							outcome = ((btn && btn.dataset.msgViolationsFound) || 'Found {found} violations ({remaining} remaining)')
								.replace('{found}', data.violations_found).replace('{remaining}', data.violations_remaining);
						}
						var fullMsg = summary ? (summary + ' ' + outcome) : outcome;
						// Prefer the sticky toast so the summary persists
						// until the user dismisses it, but fall back to
						// the transient success toast if the sticky
						// helper is unavailable or throws (e.g. the
						// toast container is missing from the DOM).
						try {
							if (typeof window.showStickyToast === 'function') {
								lastRunStickyToast = window.showStickyToast(fullMsg);
							} else {
								showSuccessToast(fullMsg);
							}
						} catch (e) {
							lastRunStickyToast = null;
							showSuccessToast(fullMsg);
						}
						resetRuleButton();
						// Refresh health summary and compliance table if present.
						if (document.getElementById('health-summary')) {
							htmx.ajax('GET', '/api/v1/reports/health', {target: '#health-summary', swap: 'innerHTML'});
						}
						if (document.getElementById('compliance-summary')) {
							htmx.ajax('GET', '/api/v1/reports/health/by-library', {target: '#compliance-summary', swap: 'innerHTML'});
						}
						htmx.ajax('GET', '/api/v1/notifications/badge', {target: '#sidebar-notif-badge', swap: 'innerHTML'});
						return true;
					}
					if (data.status === 'failed') {
						showToast(((btn && btn.dataset.toastEvaluationFailed) || 'Rule evaluation failed') + ': ' + (data.error || 'unknown error'));
						resetRuleButton();
						return true;
					}
					if (data.status === 'idle') {
						showToast((btn && btn.dataset.toastIdle) || 'Rule run state was lost');
						resetRuleButton();
						return true;
					}
					return false;
				},
				onHTTPError: function(status) {
					showToast(((btn && btn.dataset.toastStatusHttpError) || 'Status check failed (HTTP {status})').replace('{status}', status));
					resetRuleButton();
				},
				onNetworkError: function() {
					showToast((btn && btn.dataset.toastStatusNetworkError) || 'Network error while checking rule status');
					resetRuleButton();
				}
			}, {maxAttempts: 0});
		}

		function resetRuleButton() {
			var btn = document.getElementById('run-rules-btn');
			var allBtn = document.getElementById('run-rules-all-btn');
			var spinner = document.getElementById('run-rules-spinner');
			var label = document.getElementById('run-rules-label');
			if (btn) btn.disabled = false;
			if (allBtn) allBtn.disabled = false;
			if (spinner) spinner.classList.add('hidden');
			if (label) label.textContent = (btn && btn.dataset.labelRun) || 'Run Rules';
		}

		// buildRunSummary returns the incremental-benefit sentence for
		// the dirty tracker (#698): "Evaluated {processed} of {total}
		// artists ({skipped} unchanged)." for scope=incremental, or
		// "Evaluated all {total} artists." for scope=all. Returns an
		// empty string when totals are missing so the caller can render
		// the outcome alone.
		function buildRunSummary(data) {
			var total = data.artists_total || 0;
			if (total <= 0) return '';
			var btn = document.getElementById('run-rules-btn');
			var ds = btn ? btn.dataset : {};
			if (data.scope === 'all') {
				return (ds.msgEvaluatedSummaryAll || 'Evaluated all {total} artists.')
					.replace('{total}', total);
			}
			var processed = data.artists_processed || 0;
			var skipped = data.artists_skipped || 0;
			return (ds.msgEvaluatedSummary || 'Evaluated {processed} of {total} artists ({skipped} unchanged).')
				.replace('{processed}', processed)
				.replace('{total}', total)
				.replace('{skipped}', skipped);
		}
	</script>
}
