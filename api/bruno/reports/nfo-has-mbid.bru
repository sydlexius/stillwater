meta {
  name: Rule-Written MusicBrainz ID Report
  type: http
  seq: 18
}

get {
  url: {{apiBase}}/reports/nfo-has-mbid?page=1&page_size=50
  body: none
  auth: none
}

headers {
  Cookie: session={{sessionToken}}
}

docs {
  Lists artists whose MusicBrainz ID was written by the automatic NFO rule fix,
  so an operator can review IDs a rule guessed. Read-only; this route writes
  nothing, contacts MusicBrainz for nothing, and validates no ID.

  On an empty CI database there are no rows, so the assertions below check the
  envelope rather than the contents. The caveat block is asserted because it
  must be present even when the report is empty: an empty row list with no
  statement of what the report cannot see would read as a clean bill of health,
  and other parts of Stillwater assign a MusicBrainz ID without recording
  anything at all.
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("rows is an array, never null", function() {
    expect(res.body.rows).to.be.an("array");
    expect(res.body.total).to.be.a("number");
  });

  test("both counts are reported", function() {
    expect(res.body.counts.writes).to.be.a("number");
    expect(res.body.counts.artists).to.be.a("number");
    expect(res.body.counts.total).to.be.a("number");
  });

  test("every caveat is present even when the report is empty", function() {
    expect(res.body.caveats.scope).to.be.a("string").and.not.empty;
    expect(res.body.caveats.floor).to.be.a("string").and.not.empty;
    expect(res.body.caveats.retention).to.be.a("string").and.not.empty;
    expect(res.body.caveats.no_prior_value).to.be.a("string").and.not.empty;
    expect(res.body.caveats.not_confirmed).to.be.a("string").and.not.empty;
    expect(res.body.caveats.message_wording).to.be.a("string").and.not.empty;
  });

  test("the scope caveat names the paths this report cannot see", function() {
    // The load-bearing caveat: it must say the other writers are invisible,
    // not merely describe what the report does cover.
    expect(res.body.caveats.scope).to.match(/Identify/);
    expect(res.body.caveats.scope).to.match(/bulk rule run/);
  });
}
