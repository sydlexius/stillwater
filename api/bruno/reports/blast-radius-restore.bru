meta {
  name: Blast Radius Restore
  type: http
  seq: 18
}

post {
  url: {{apiBase}}/reports/blast-radius/restore
  body: json
  auth: none
}

headers {
  Cookie: session={{sessionToken}}
}

body:json {
  {
    "change_ids": ["00000000-0000-0000-0000-000000000000"],
    "commit": false
  }
}

docs {
  Restore half of the blast-radius report (#2750): puts an operator value an
  automated writer destroyed back onto the artist. POST
  /api/v1/reports/blast-radius/restore with {change_ids, commit?} (snake_case).

  commit is AFFIRMATIVE, not dry_run: a Go bool zero-values to false, so a
  dry_run field would mean a request that omitted it WRITES. With commit
  omitted or false the request PREVIEWS -- the identical eligibility pass runs
  and reports the plan without writing anything, so this request is safe to
  run against any instance, CI or otherwise.

  Admin-gated: the gate is in-handler (requireForeignAdmin), not on the route,
  so an unauthenticated caller gets 401 and an authenticated non-admin gets
  403. The CI session is the bootstrap admin (ci-admin), so the admin gate
  passes and the request reaches the handler body.

  Singleton: this endpoint claims its OWN slot (r.blastRestoreRunning under
  r.blastRestoreMu), separate from the destructive-fanart and registry-repair
  slots, so a concurrent blast-radius restore gets 409 but does not contend
  with those other passes.

  Empty-CI-DB expectation asserted here: the request sends a change id that
  cannot resolve to a real metadata_changes row on a fresh instance, so
  planOneBlastRestore's first allow-list check (the id must resolve exactly)
  refuses it with reason "change_not_found". That refusal needs no seeded
  fixture and is deterministic, and because commit is false the plan is
  reported rather than executed regardless.

  What this asserts: the response shape (commit/dry_run echoed, the counters,
  and the per-item envelope with restore_status and refuse_reason), and that a
  preview against an unresolvable id reports the item refused with
  change_not_found rather than reporting anything restored. What it
  deliberately does NOT assert: a "planned" or "restored" outcome, since that
  would need a seeded metadata_changes row and a live artist to be current
  for -- exercising the full allow-list chain belongs to the Go integration
  tests in internal/api, not this smoke request.
}

tests {
  test("preview returns 200 for an unresolvable change id", function() {
    expect(res.status).to.equal(200);
  });

  test("content-type is application/json", function() {
    expect(res.headers['content-type']).to.include('application/json');
  });

  test("commit:false is reported as a dry run", function() {
    // The mode must round-trip: a report detached from its request must
    // still say whether anything was written.
    expect(res.body).to.be.an("object");
    expect(res.body.commit).to.equal(false);
    expect(res.body.dry_run).to.equal(true);
  });

  test("nothing is reported as restored on a preview", function() {
    expect(res.body.restored).to.equal(0);
  });

  test("the unresolvable id is refused as change_not_found", function() {
    expect(res.body.items).to.be.an("array").with.lengthOf(1);
    expect(res.body.items[0].restore_status).to.equal("refused");
    expect(res.body.items[0].refuse_reason).to.equal("change_not_found");
  });

  test("refused count matches the single item", function() {
    expect(res.body.refused).to.equal(1);
    expect(res.body.eligible).to.equal(0);
  });
}
