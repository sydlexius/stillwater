meta {
  name: Registry Repair Status
  type: http
  seq: 20
}

get {
  url: {{apiBase}}/reports/registry-repair/status
  body: none
  auth: none
}

headers {
  Cookie: session={{sessionToken}}
}

docs {
  Status of the async image registry repair run (#2678): idle, running,
  completed (report set) or failed (error set). Always 200. Admin-gated.

  Depends on registry-repair-remediate.bru (seq 15) having started a preview.
  The pre-request script polls (bounded, 15s) until that run is no longer
  running, so the tests below assert the completed report unconditionally.
}

script:pre-request {
  const url = bru.interpolate(req.getUrl());
  const cookie = bru.interpolate(req.getHeader('Cookie'));
  for (let i = 0; i < 60; i++) {
    const r = await bru.sendRequest({ method: 'GET', url: url, headers: { Cookie: cookie } });
    if (r.data && r.data.running === false) { break; }
    await bru.sleep(250);
  }
}

tests {
  test("status returns 200 JSON", function() {
    expect(res.status).to.equal(200);
    expect(res.headers['content-type']).to.include('application/json');
  });

  test("the preview run completed and is reported as a dry run", function() {
    expect(res.body.running).to.equal(false);
    expect(res.body.status).to.equal("completed");
    expect(res.body.commit).to.equal(false);
    expect(res.body.dry_run).to.equal(true);
  });

  test("absent and unreadable are distinct, and every counter is zero", function() {
    var rep = res.body.report;
    expect(rep).to.be.an("object");
    expect(rep.dry_run).to.equal(true);
    expect(rep.absent).to.equal(0);
    expect(rep.unreadable).to.equal(0);
    expect(rep.scanned).to.equal(0);
    expect(rep.rebuilt).to.equal(0);
    expect(rep.restored).to.equal(0);
  });

  test("both nested per-pass results are present and dry", function() {
    expect(res.body.report.rebuild).to.be.an("object");
    expect(res.body.report.restore).to.be.an("object");
    expect(res.body.report.rebuild.dry_run).to.equal(true);
    expect(res.body.report.restore.dry_run).to.equal(true);
  });
}
