meta {
  name: AI Blocklist Status
  type: http
  seq: 4
}

get {
  url: {{apiBase}}/images/ai-blocklist/status
  body: none
  auth: none
}

headers {
  Cookie: session={{sessionToken}}
}

tests {
  test("returns 200 for the admin session", function() {
    expect(res.status).to.equal(200);
  });

  test("reports the download as off in the harness", function() {
    // The Bruno harness starts the server with SW_AI_BLOCKLIST_URL empty, which
    // turns the download off, so no list is loaded and no host is shown.
    expect(res.body.enabled).to.equal(false);
    expect(res.body.loaded).to.equal(false);
    expect(res.body.source_host).to.equal(undefined);
    expect(res.body.source).to.equal(undefined);
    expect(res.body.source_repo).to.equal(undefined);
  });
}
